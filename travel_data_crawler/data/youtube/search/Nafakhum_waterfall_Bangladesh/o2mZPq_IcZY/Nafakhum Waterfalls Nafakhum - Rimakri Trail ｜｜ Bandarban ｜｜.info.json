ot jump over the height of the fall.\n\n======================================================\nChannel Link: https://www.youtube.com/channel/UCXUzddQaUKaR_IBU5Zf2Jsg?view_as=subscriber\n#nafakhum#waterfalls#remakcri\n\nVisit Dubai: https://www.youtube.com/watch?v=OIX0_the5MM&t=3s\n\nVisit 3rd Airport Terminal in Bangladesh: https://www.youtube.com/watch?v=Zcb377D_ZqU&t=2s\n\nMusic: https://www.bensound.com/\n\nAlso, Connect with our social Links:", "channel_id": "UCXUzddQaUKaR_IBU5Zf2Jsg", "channel_url": "https://www.youtube.com/channel/UCXUzddQaUKaR_IBU5Zf2Jsg", "duration": 694, "view_count": 200, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=o2mZPq_IcZY", "categories": ["Travel & Events"], "tags": ["nafakhum", "nafakhum waterfall", "bandarban", "nafa khum", "remakri", "beautiful nafa khum", "bangladesh", "waterfall", "thanchi", "nafa-khum", "nafakhum bandarban", "falls", "nafakhum tour", "nature", "bandarban tour", "amiakhum waterfall", "how to go nafakhum", "adventure", "debota pahar", "beautiful bangladesh", "nafakhum bandarban tour", "sangu river", "amiakhum tour", "boro pathor", "nafakhum to jinapara", "rangamati", "nafakhum and amiakhum", "travel", "sangu river bandarban", "sangu nodi", "sangu river thanchi", "beauty of sangu river"], "playable_in_embed": false, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 3, "location": "NAFAKUM WATERFALLS", "like_count": 3, "channel": "Bangladeshi Trekker", "channel_follower_count": 4000, "uploader": "Bangladeshi Trekker", "uploader_id": "@BangladeshiTrekker", "uploader_url": "https://www.youtube.com/@BangladeshiTrekker", "upload_date": "20200225", "timestamp": 1582638881, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "displ