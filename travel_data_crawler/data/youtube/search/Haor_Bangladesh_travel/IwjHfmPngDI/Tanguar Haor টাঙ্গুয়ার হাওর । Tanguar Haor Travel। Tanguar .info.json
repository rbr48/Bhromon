han 140 species of fresh water fish in the haor. The more predominant among them are: ayir, Cat fish, baim, tara, gutum, gulsha, tengra, titna, garia, beti, kakia. Gulli, balua, ban tulsi, nalkhagra and other freshwater wetland trees are in this haor.", "channel_id": "UCdo6qahD0O6rMy_3ogIHbPQ", "channel_url": "https://www.youtube.com/channel/UCdo6qahD0O6rMy_3ogIHbPQ", "duration": 20, "view_count": 59, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=IwjHfmPngDI", "categories": ["Travel & Events"], "tags": [], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "like_count": 3, "channel": "Chitra By Nasrin Eni", "channel_follower_count": 455, "uploader": "Chitra By Nasrin Eni", "uploader_id": "@chitrabynasrineni", "uploader_url": "https://www.youtube.com/@chitrabynasrineni", "upload_date": "20230901", "timestamp": 1693584015, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "display_id": "IwjHfmPngDI", "fulltitle": "Tanguar Haor টাঙ্গুয়ার হাওর । Tanguar Haor Travel। Tanguar Haor Cooming Soon", "duration_string": "20", "is_live": false, "was_live": false, "epoch": 1781109459, "asr": 44100, "format_id": "18", "format_note": "360p", "source_preference": -1, "fps": 20, "audio_channels": 2, "height": 360, "quality": 6.0, "has_drm": false, "tbr": 467.886, "filesize_approx": 1193694, "width": 636, "language_preference": -1, "ext": "mp4", "vcodec": "avc1.42001E", "acodec": "mp4a.40.2", "dynamic_range": "SDR", "url": "https://rr1---sn-vg5obxcq-jb2s.googlevideo.com/videoplayback?expire=1781131063&ei=15Ipaq3NJ72j9fwP3eSAoAg&ip=122.152.50.174&id=o-ACCTOjzF3VUcht_XDEjTHHVh_aHqCOJy24vvasaM_41O&itag=18&source=youtube&requiressl=yes&xpc=EgVo2aDSNQ%3D%3D&cps=294&met=1781109463%2C&mh=54&m