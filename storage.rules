rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Shared helpers ──────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }

    // Maximum allowed file sizes
    function underImageLimit() { return request.resource.size < 10 * 1024 * 1024; }  // 10 MB
    function underVideoLimit() { return request.resource.size < 100 * 1024 * 1024; } // 100 MB

    // Only allow image MIME types
    function isImage() {
      return request.resource.contentType != null && request.resource.contentType.matches('image/.*');
    }
    // Only allow video MIME types
    function isVideo() {
      return request.resource.contentType != null && request.resource.contentType.matches('video/.*');
    }
    // Only allow audio MIME types
    function isAudio() {
      return request.resource.contentType != null && request.resource.contentType.matches('audio/.*');
    }

    // ── Tour Group media (posts, reels, stories, scrapbook) ─────────────────
    // Only active members of the tour can read or upload its media. Uploads
    // must carry uploadedByEmail metadata, which lets the uploader (or an
    // admin) delete their own files later.
    function tourEmail() {
      return request.auth.token.email != null
        ? request.auth.token.email.lower()
        : (request.auth.uid + '@bhromon.app');
    }
    function tourMembership(tourId) {
      return firestore.get(/databases/(default)/documents/memberships/$(tourId + '__' + tourEmail()));
    }
    function isTourOwner(tourId) {
      return isAuth() &&
             firestore.exists(/databases/(default)/documents/tours/$(tourId)) &&
             firestore.get(/databases/(default)/documents/tours/$(tourId)).data.ownerEmail == tourEmail();
    }
    function isTourMember(tourId) {
      return isAuth() && (
        isTourOwner(tourId) ||
        (firestore.exists(/databases/(default)/documents/memberships/$(tourId + '__' + tourEmail())) &&
         tourMembership(tourId).data.status == 'active')
      );
    }
    function isTourAdmin(tourId) {
      return isTourOwner(tourId) ||
        (isAuth() &&
         firestore.exists(/databases/(default)/documents/memberships/$(tourId + '__' + tourEmail())) &&
         tourMembership(tourId).data.role in ['admin', 'owner']);
    }

    match /tours/{tourId}/{allPaths=**} {
      allow read: if isTourMember(tourId);
      // Images up to 10 MB, videos up to 100 MB; the size limit follows the type.
      allow create, update: if isTourMember(tourId)
                            && request.resource.metadata != null
                            && request.resource.metadata.get('uploadedByEmail', '') == tourEmail()
                            && ((isImage() && underImageLimit()) || (isVideo() && underVideoLimit()));
      allow delete: if isTourMember(tourId)
                    && ((resource.metadata != null && resource.metadata.get('uploadedByEmail', '') == tourEmail()) || isTourAdmin(tourId));
    }

    // ── Trip Log media ───────────────────────────────────────────────────────
    // Read: public (trip logs are community-shared content)
    // Write: authenticated users only, with file size caps
    match /trip_logs/{tripId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth()
                   && (underImageLimit() || underVideoLimit())
                   && (
                     (!firestore.exists(/databases/default/documents/trip_logs/$(tripId)))
                     || (firestore.get(/databases/default/documents/trip_logs/$(tripId)).data.authorId == request.auth.uid)
                   );
    }

    match /explorer_profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuth()
                   && isOwner(userId)
                   && (isImage() || isAudio())
                   && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAuth() && isOwner(userId);
    }

    // ── Chat media, docs & voice (VPS fallback & legacy) ─────────────────────
    match /chat_media/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /chat_docs/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /chat_voice/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── Chat media thumbnails (written by Cloud Functions service account) ──
    // Read: authenticated users; write is denied from client (CF writes via Admin SDK)
    match /chat_media_thumbs/{chatId}/{fileName} {
      allow read:  if isAuth();
      allow write: if false; // Cloud Function service account bypasses rules
    }

    // ── Offline vault tiles ──────────────────────────────────────────────────
    // Read: authenticated users only
    // Write: blocked from client (tiles are managed by admin/Cloud Function)
    match /offline_tiles/{allPaths=**} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ── Deny all other paths by default ──────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
