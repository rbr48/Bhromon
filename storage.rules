rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Shared helpers ──────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }

    // Maximum allowed file sizes
    function underImageLimit() { return request.resource.size < 10 * 1024 * 1024; }  // 10 MB
    function underVideoLimit() { return request.resource.size < 100 * 1024 * 1024; } // 100 MB

    // Only allow image MIME types
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    // Only allow video MIME types
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }
    // Only allow audio MIME types
    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    // ── Tour Group media (posts, reels, stories, scrapbook) ─────────────────
    match /tours/{tourId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth()
                   && (isImage() || isVideo() || isAudio())
                   && (underImageLimit() || underVideoLimit());
    }

    // ── Trip Log media ───────────────────────────────────────────────────────
    // Read: public (trip logs are community-shared content)
    // Write: authenticated users only, with file size caps
    match /trip_logs/{tripId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth()
                   && (underImageLimit() || underVideoLimit())
                   && (
                     (!firestore.exists(/databases/default/documents/trip_logs/$(tripId)))
                     || (firestore.get(/databases/default/documents/trip_logs/$(tripId)).data.authorId == request.auth.uid)
                   );
    }

    match /explorer_profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuth()
                   && isOwner(userId)
                   && (isImage() || isAudio())
                   && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAuth() && isOwner(userId);
    }

    // ── Chat media ───────────────────────────────────────────────────────────
    // Read: only participants of the chat (chatId is "{uid1}_{uid2}" sorted)
    // Write: only participants, with file type and size enforcement
    match /chat_media/{chatId}/{fileName} {
      function isChatParticipant() {
        return isAuth() && request.auth.uid in chatId.split('_');
      }
      allow read: if isChatParticipant();
      allow write: if isChatParticipant()
                   && (isImage() || isVideo())
                   && (underImageLimit() || underVideoLimit());
    }

    // ── Chat media thumbnails (written by Cloud Functions service account) ──
    // Read: only participants; write is denied from client (CF writes via Admin SDK)
    match /chat_media_thumbs/{chatId}/{fileName} {
      function isChatParticipant() {
        return isAuth() && request.auth.uid in chatId.split('_');
      }
      allow read:  if isChatParticipant();
      allow write: if false; // Cloud Function service account bypasses rules
    }

    // ── Offline vault tiles ──────────────────────────────────────────────────
    // Read: authenticated users only (premium content)
    // Write: blocked from client (tiles are managed by admin/Cloud Function)
    match /offline_tiles/{allPaths=**} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ── Deny all other paths by default ──────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
