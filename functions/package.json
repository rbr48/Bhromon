{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "serve:games": "npm run build && node lib/server.js",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "test": "jest",
    "backfill:geohashes": "npm run build && node lib/scripts/backfillGeohashes.js"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "googleapis": "^188.0.0",
    "sharp": "^0.35.5",
    "@google-cloud/storage": "^7.14.0"
  },
  "overrides": {
    "protobufjs": "^7.4.0",
    "@grpc/grpc-js": "^1.13.6",
    "uuid": "^11.1.1",
    "body-parser": "^1.20.3"
  },
  "devDependencies": {
    "typescript": "^4.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "@types/jest": "^30.0.0",
    "@firebase/rules-unit-testing": "^6.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/tests/**/*.test.js"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "esModuleInterop": true,
            "target": "es2021"
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(jose|jwks-rsa)/)"
    ]
  },
  "private": true
}
