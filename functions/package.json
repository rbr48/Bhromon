{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "test": "jest",
    "backfill:geohashes": "npm run build && node lib/scripts/backfillGeohashes.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "googleapis": "^126.0.0",
    "sharp": "^0.35.5",
    "@google-cloud/storage": "^7.14.0"
  },
  "overrides": {
    "protobufjs": "^7.4.0",
    "@grpc/grpc-js": "^1.13.6",
    "uuid": "^11.1.1",
    "body-parser": "^1.20.3"
  },
  "devDependencies": {
    "typescript": "^4.9.0",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.12",
    "@firebase/rules-unit-testing": "^2.0.7"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/tests/**/*.test.js"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "private": true
}
