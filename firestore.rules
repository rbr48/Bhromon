rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()   { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function profile()  {
      return get(/databases/$(database)/documents/explorer_profiles/$(request.auth.uid)).data;
    }
    function isNotUnverified()       { return isAuth(); }
    function isVerifiedOrAbove()     { return isAuth() && profile().tier in ['verified','regionExpert','pioneer']; }
    function isRegionExpertOrAbove() { return isAuth() && profile().tier in ['regionExpert','pioneer']; }

    // ---- Field Validation Helpers ----
    // Ensures a timestamp field on the incoming document is not set in the future
    // (prevents timestamp manipulation exploits)
    function notFutureTimestamp(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == request.time ||
             request.resource.data[field] <= request.time;
    }

    // Ensures a string field does not exceed the given character limit
    function maxLength(field, limit) {
      return !(field in request.resource.data) ||
             request.resource.data[field].size() <= limit;
    }

    // Validates that a required field exists and is not empty
    function hasField(field) {
      return field in request.resource.data && request.resource.data[field] != '';
    }

    // Prevents escalation: users cannot write protected tier/badge fields
    function noTierEscalation() {
      return !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['tier', 'isPioneer', 'isRegionExpert', 'explorerScore', 'promotedBy']);
    }

    // Validates a text field length (for anti-spam on free-text inputs)
    function validText(field, minLen, maxLen) {
      return field in request.resource.data &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    // ---- Location Pins ----
    match /location_pins/{id} {
      allow list: if true;   // collection queries allowed for everyone (map screen)
      allow get:  if !resource.data.hidden || isAuth();
      allow create: if isNotUnverified() && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isOwner(resource.data.createdByUid) || isRegionExpertOrAbove();
      allow delete: if isRegionExpertOrAbove();

      match /live_tips/{tipId} {
        allow read: if true;
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuth() && (isOwner(resource.data.authorId) || isRegionExpertOrAbove());
      }
    }

    // ---- Trip Logs (diary entries with privacy tiers) ----
    match /trip_logs/{id} {
      // Helper: check if viewer follows the author
      function isFollowing(authorId) {
        return isAuth() && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + authorId));
      }

      // Visibility-aware read logic:
      // private   → only the author
      // friends   → author or followers
      // community → everyone (if not hidden)
      function canRead() {
        let vis = resource.data.visibility;
        let authorId = resource.data.authorId;
        let isHidden = resource.data.hidden == true;

        return (vis == 'private' && isAuth() && isOwner(authorId))
            || (vis == 'friends' && isAuth() && (isOwner(authorId) || isFollowing(authorId)))
            || (vis == 'community' && !isHidden)
            || (vis == 'community' && isAuth() && isOwner(authorId));
      }

      // list queries: clients filter on visibility client-side;
      // server can't enforce complex visibility in collection queries without
      // an expensive cross-document check — allow authenticated list, app filters.
      allow list: if isAuth();
      allow get:  if canRead();

      // Titles are capped at 200 chars (matches the client editor limit)
      function hasValidTitle() {
        return !('title' in request.resource.data)
            || (request.resource.data.title is string
                && request.resource.data.title.size() <= 200);
      }

      allow create: if isAuth()
                    && request.resource.data.authorId == request.auth.uid
                    && hasValidTitle();

      allow update: if (isOwner(resource.data.authorId)
                    && request.resource.data.authorId == resource.data.authorId
                    && hasValidTitle()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hidden', 'hiddenReason', 'tier', 'trustScore'])
                    // Owner can only update visibility within valid values
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['visibility'])
                        || request.resource.data.visibility in ['private', 'friends', 'community']))
                    || (isAuth()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
                        && request.resource.data.reportCount == (('reportCount' in resource.data ? resource.data.reportCount : 0) + 1));
      allow delete: if isOwner(resource.data.authorId) || isRegionExpertOrAbove();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuth() && (isOwner(resource.data.authorId) || isRegionExpertOrAbove());
      }

      // ---- Diary Reactions (wantToGo, beenHere, learned, beautiful) ----
      match /reactions/{userId} {
        allow read: if true;
        allow write: if isAuth() && isOwner(userId);
      }
    }

    // ---- Archived Trip Logs ----
    match /archived_trip_logs/{id} {
      allow list: if true;
      allow get:  if !resource.data.hidden || (isAuth() && isOwner(resource.data.authorId));
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId)
                    && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isOwner(resource.data.authorId) || isRegionExpertOrAbove();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuth() && (isOwner(resource.data.authorId) || isRegionExpertOrAbove());
      }
    }

    // ---- Pro Tips ----
    match /pro_tips/{id} {
      allow list: if true;
      allow get:  if !resource.data.hidden || (isAuth() && isOwner(resource.data.authorId));
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId);
      allow delete: if isOwner(resource.data.authorId) || isRegionExpertOrAbove();
    }

    match /explorer_profiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
                    && (!('tier' in request.resource.data) || request.resource.data.tier == 'unverified')
                    && (!('isPioneer' in request.resource.data) || request.resource.data.isPioneer == false)
                    && (!('isRegionExpert' in request.resource.data) || request.resource.data.isRegionExpert == false)
                    && (!('badges' in request.resource.data) || request.resource.data.badges.size() == 0)
                    && (!('explorerScore' in request.resource.data) || (request.resource.data.explorerScore.value == 0 && request.resource.data.explorerScore.tier == 'unverified'))
                    && (!('promotedBy' in request.resource.data));
      allow update: if (isOwner(uid)
                    && !request.resource.data.diff(resource.data)
                       .affectedKeys().hasAny(['tier','badges','isPioneer','isRegionExpert','explorerScore','promotedBy']))
                    || isRegionExpertOrAbove();
      allow delete: if isOwner(uid);

      match /blocked_users/{blockedUid} {
        allow read: if isAuth() && (isOwner(uid) || request.auth.uid == blockedUid);
        allow write: if isAuth() && isOwner(uid);
      }

      // ---- Saved Diaries ----
      match /saved_diaries/{tripLogId} {
        allow read: if isAuth() && isOwner(uid);
        allow write: if isAuth() && isOwner(uid);
      }

      // ---- Bucket List ----
      match /bucket_list/{itemId} {
        allow read: if true;
        allow write: if isAuth() && isOwner(uid);
      }
    }

    // ---- Content Reports ----
    match /travel_log_reports/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isRegionExpertOrAbove();
    }

    // ---- Explorer Scores ----
    match /explorer_scores/{uid} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ---- Trust Events ----
    match /trust_events/{id} {
      allow create: if isAuth()
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.timestamp == request.time
                    && (
                      (request.resource.data.type == 'trip_published' && request.resource.data.weight == 25) ||
                      (request.resource.data.type == 'endorsement' && request.resource.data.weight == 10) ||
                      (request.resource.data.type == 'helpful_vote' && request.resource.data.weight == 5) ||
                      (request.resource.data.type == 'spam_flag' && (request.resource.data.weight == -5 || request.resource.data.weight == 1)) ||
                      (request.resource.data.type == 'safety_flag' && (request.resource.data.weight == -5 || request.resource.data.weight == 1)) ||
                      isRegionExpertOrAbove()
                    );
      allow read, update, delete: if false;
    }

    // ---- Flag Appeals ----
    match /flag_appeals/{id} {
      allow create: if isAuth() && request.resource.data.appellantUid == request.auth.uid;
      allow read:   if isAuth() && (isOwner(resource.data.appellantUid) || isRegionExpertOrAbove());
      allow update: if isRegionExpertOrAbove();
      allow delete: if false;
    }

    // ---- FCM Tokens ----
    match /fcm_tokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ---- App Config (read by app, write by admin web only via service account) ----
    match /app_config/{id} {
      allow read: if true;
      allow write: if isRegionExpertOrAbove();
    }

    // ---- Suggested Pins (users submit; admins review) ----
    match /suggested_pins/{id} {
      allow create: if isNotUnverified()
                    && request.resource.data.submittedBy == request.auth.uid;
      allow read, update, delete: if isRegionExpertOrAbove();
    }

    // ---- Push Notifications (admin sends, all users read own) ----
    match /notifications/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isRegionExpertOrAbove();
    }

    // ---- Admin Audit Logs (write-only by auth; read by admins) ----
    match /admin_audit_logs/{id} {
      allow create: if isRegionExpertOrAbove();
      allow read:   if isRegionExpertOrAbove();
      allow update, delete: if false;
    }

    // ---- Direct Messages (admin writes to inbox; user reads own inbox) ----
    match /direct_messages/{uid}/inbox/{msgId} {
      allow read:   if isOwner(uid) || isRegionExpertOrAbove();
      allow create: if isRegionExpertOrAbove();
      allow update: if isOwner(uid);  // mark as read
      allow delete: if false;
    }

    // ---- Follows ----
    match /follows/{id} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.followerId == request.auth.uid;
    }

    // ---- Likes ----
    match /likes/{id} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ---- Pin Visits ----
    match /pin_visits/{id} {
      // Signed-in users only: the "recent visitors" list stays, but visit
      // history is no longer readable by anonymous clients.
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Safety Reports ----
    match /safety_reports/{id} {
      allow create: if true;
      allow read, update, delete: if isRegionExpertOrAbove();
    }

    // ---- Geo Fence Triggers ----
    match /geo_fence_triggers/{id} {
      allow create: if true;
      allow read, update, delete: if isRegionExpertOrAbove();
    }

    // ---- Users ----
    match /users/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);

      match /badges/{id} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }

      match /wishlist/{id} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }

      match /trust_history/{id} {
        allow read: if isAuth();
        allow write: if isOwner(uid);
      }

      match /notifications/{id} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isAuth()
                      && request.resource.data.timestamp == request.time
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0;
      }
    }

    // ── Chats & Messages ────────────────────────────────────────────────────
    // Chat document ID format: "{uid1}_{uid2}" (UIDs sorted lexicographically).
    // This allows a simple participant check without a cross-document read.
    match /chats/{chatId} {
      // A user is a participant if their uid is part of the chatId or in the participants list.
      function isParticipant() {
        return isAuth() && (
          chatId.matches('^' + request.auth.uid + '_.*') ||
          chatId.matches('.*_' + request.auth.uid + '$') ||
          (resource != null && 'participants' in resource.data && request.auth.uid in resource.data.participants)
        );
      }

      // Chat metadata: only participants may read or update last-message fields.
      allow read:   if isParticipant();
      allow create: if isParticipant() || (isAuth() && request.auth.uid in request.resource.data.participants);
      allow update: if isParticipant()
                    // Allow updating metadata fields (lastMessage, lastMessageTime, typing_*)
                    // and allow preserving participants list
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants'])
                      || request.resource.data.participants == resource.data.participants
                    );
      allow delete: if false;

      match /messages/{messageId} {
        // Validate outgoing messages: sender must be the authenticated user,
        // type must be a known value, and text must not exceed 4 096 chars.
        function validMessage() {
          let d = request.resource.data;
          return d.senderId == request.auth.uid
              && d.type in ['text', 'image', 'video', 'audio', 'document', 'location', 'contact', 'deleted', 'call', 'expense']
              && (!('text' in d) || d.text == null || (d.text is string && d.text.size() <= 4096))
              && ('timestamp' in d && d.timestamp == request.time);
        }

        allow read:   if isParticipant();
        allow create: if isParticipant() && validMessage();
        // Allow updates for delivery receipts, reactions, edits, Delete for Me, and Delete for Everyone
        allow update: if isParticipant()
                      && (
                        // Recipient marking seen or delivered
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'status', 'deliveredAt', 'readAt'])
                         && request.auth.uid != resource.data.senderId)
                        // Participant adding own UID to deletedFor array ("Delete for Me")
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
                            && request.auth.uid in request.resource.data.deletedFor)
                        // Participant adding or changing their own reaction
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
                        // Sender editing their own text message within 15 minutes
                        || (request.auth.uid == resource.data.senderId
                            && resource.data.type == 'text'
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt'])
                            && request.resource.data.isEdited == true
                            && request.time < resource.data.timestamp + duration.value(15, 'm'))
                        // Sender tombstoning their own message ("Delete for Everyone") within 60 hours
                        || (request.auth.uid == resource.data.senderId
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'text', 'isDeleted', 'deletedAt'])
                            && request.resource.data.type == 'deleted'
                            && request.resource.data.isDeleted == true
                            && request.time < resource.data.timestamp + duration.value(60, 'h'))
                        // Star toggle for participant
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isStarred', 'starredBy']))
                        // View-once media opened mark
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOpened', 'openedAt']))
                        // Travel expense split settlement
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSettled']))
                      );
        allow delete: if false;
      }
    }

    // ── WebRTC Calling & Signaling ───────────────────────────────────────────
    match /calls/{callId} {
      function isCallParticipant() {
        return isAuth() && (
          (resource != null && (
            request.auth.uid == resource.data.callerId ||
            request.auth.uid == resource.data.calleeId ||
            tourUserEmail() == resource.data.callerId ||
            tourUserEmail() == resource.data.calleeId ||
            (resource.data.participants != null && (
              request.auth.uid in resource.data.participants ||
              tourUserEmail() in resource.data.participants
            ))
          )) ||
          (resource == null && (
            request.auth.uid == request.resource.data.callerId ||
            request.auth.uid == request.resource.data.calleeId ||
            tourUserEmail() == request.resource.data.callerId ||
            tourUserEmail() == request.resource.data.calleeId ||
            (request.resource.data.participants != null && (
              request.auth.uid in request.resource.data.participants ||
              tourUserEmail() in request.resource.data.participants
            ))
          ))
        );
      }

      allow read, write: if isCallParticipant();

      match /offerCandidates/{candidateId} {
        allow read, write: if isAuth();
      }

      match /answerCandidates/{candidateId} {
        allow read, write: if isAuth();
      }
    }

    // ── Rate-Limit Violations (written by Cloud Functions, read by admins) ──
    match /rate_limit_violations/{uid} {
      allow read:   if isRegionExpertOrAbove();
      allow write:  if false; // Only Cloud Functions service account may write
    }

    // ── Tour Groups & Memberships (Family Bhromon Engine) ───────────────────
    function tourUserEmail() {
      return (request.auth.token.email != null)
        ? request.auth.token.email.lower()
        : (request.auth.uid + '@bhromon.app');
    }

    // ---- Tour Group helpers ----
    // Membership docs are keyed `{tourId}__{email}`. get() and exists() bypass
    // read rules, so these helpers can inspect any tour's membership.
    function tourMemberPath(tId) {
      return /databases/$(database)/documents/memberships/$(tId + '__' + tourUserEmail());
    }
    function isActiveMember(tId) {
      return isAuth() && (
        isOwnerOfTour(tId) ||
        (exists(tourMemberPath(tId)) && get(tourMemberPath(tId)).data.status == 'active')
      );
    }
    function isTourAdmin(tId) {
      return isOwnerOfTour(tId) ||
             (isActiveMember(tId) && exists(tourMemberPath(tId)) && get(tourMemberPath(tId)).data.role in ['admin', 'owner']);
    }
    function isOwnerOfTour(tId) {
      return isAuth() && exists(/databases/$(database)/documents/tours/$(tId)) &&
             get(/databases/$(database)/documents/tours/$(tId)).data.ownerEmail == tourUserEmail();
    }
    function isBanned(tId) {
      return exists(/databases/$(database)/documents/tours/$(tId)/bans/$(tourUserEmail()));
    }
    function isTargetBanned(tId, email) {
      return exists(/databases/$(database)/documents/tours/$(tId)/bans/$(email));
    }

    // A list of member emails (likes, viewers) changes by one entry: the caller's
    // own. Either nothing changes, the caller is added, or the caller is removed.
    function ownEntryOnly(before, after) {
      return after == before ||
        (!before.hasAll([tourUserEmail()]) &&
          after.size() == before.size() + 1 &&
          after.hasAll(before) &&
          after.hasAll([tourUserEmail()])) ||
        (before.hasAll([tourUserEmail()]) &&
          after.size() == before.size() - 1 &&
          before.hasAll(after) &&
          !after.hasAll([tourUserEmail()]));
    }

    // A count (comments on a post) moves by one at a time, or not at all.
    function movesByOneAtMost(before, after) {
      return (after - before) in [-1, 0, 1];
    }

    // ---- Tours (members only) ----
    match /tours/{tourId} {
      allow get: if isAuth() &&
                    (resource.data.ownerEmail == tourUserEmail() || isActiveMember(tourId));
      allow list: if false;
      allow create: if isAuth()
                    && request.resource.data.ownerEmail == tourUserEmail()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.inviteCode.size() >= 6;
      // Admins edit trip details; only the owner changes ownership or the invite code.
      allow update: if isOwnerOfTour(tourId) ||
                    (isTourAdmin(tourId) &&
                     !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['ownerEmail', 'ownerUid', 'inviteCode']));
      allow delete: if isOwnerOfTour(tourId);

      match /private/{docId} {
        allow read, write: if isOwnerOfTour(tourId);
      }

      // Removed members. Admins write these; joining checks them.
      match /bans/{email} {
        allow read, create, delete: if isTourAdmin(tourId);
      }

      // Expenses & deposits: any member adds; only the author or an admin edits.
      match /expenses/{expenseId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == tourUserEmail();
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == resource.data.get('addedByEmail', '') &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      match /deposits/{depositId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == tourUserEmail();
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == resource.data.get('addedByEmail', '') &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      // Settle-up payments. Any member records one they took part in, or an
      // admin records any; the author or an admin deletes it.
      match /transfers/{transferId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == tourUserEmail() &&
                         request.resource.data.amountPaisa is int &&
                         request.resource.data.amountPaisa > 0 &&
                         (isTourAdmin(tourId) ||
                          request.resource.data.fromId == tourUserEmail() ||
                          request.resource.data.toId == tourUserEmail());
        allow update: if false;
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      // Official notices are posted by admins. A member answers one ("Got
      // it", or "I'm here" in a roll call) by adding or removing only their
      // own email in ackBy. Admins may mark anyone present.
      match /notices/{noticeId} {
        allow read: if isActiveMember(tourId);
        allow create, update, delete: if isTourAdmin(tourId);
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['ackBy']) &&
                         ownEntryOnly(resource.data.get('ackBy', []), request.resource.data.get('ackBy', []));
      }

      // Packing checklist: members tick items; admins remove them.
      match /checklist/{itemId} {
        allow read, create, update: if isActiveMember(tourId);
        allow delete: if isTourAdmin(tourId);
      }

      match /itinerary/{itemId} {
        allow read: if isActiveMember(tourId);
        allow write: if isTourAdmin(tourId);
      }

      // Legacy collection kept for reads only.
      match /members/{memberId} {
        allow read: if isActiveMember(tourId);
        allow write: if false;
      }

      match /posts/{postId} {
        allow read: if isActiveMember(tourId);
        // The server stamps the time. A new post starts with no likes or comments.
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.authorEmail == tourUserEmail() &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.get('likes', []).size() == 0 &&
                         request.resource.data.get('commentCount', 0) == 0 &&
                         request.resource.data.get('images', []).size() <= 10 &&
                         request.resource.data.get('caption', '').size() <= 2200;

        // Any member likes or unlikes the post (their own entry only). Adding or
        // removing a comment moves the count by one.
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['likes', 'commentCount']) &&
                         ownEntryOnly(resource.data.get('likes', []), request.resource.data.get('likes', [])) &&
                         movesByOneAtMost(resource.data.get('commentCount', 0), request.resource.data.get('commentCount', 0));

        // The author or an admin edits the post's text, tags and settings.
        allow update: if isActiveMember(tourId) &&
                         (resource.data.get('authorEmail', '') == tourUserEmail() || isTourAdmin(tourId)) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['caption', 'location', 'tourDay', 'tags', 'isEdited', 'editedAt',
                                     'isArchived', 'isPinned', 'hideLikeCount', 'disableComments']) &&
                         request.resource.data.get('caption', '').size() <= 2200;

        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('authorEmail', '') == tourUserEmail() || isTourAdmin(tourId));

        match /comments/{commentId} {
          allow read: if isActiveMember(tourId);
          allow create: if isActiveMember(tourId) &&
                           request.resource.data.authorEmail == tourUserEmail() &&
                           request.resource.data.createdAt == request.time &&
                           request.resource.data.get('text', '').size() <= 500;

          // Any member likes or unlikes a comment (their own entry only).
          allow update: if isActiveMember(tourId) &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['likes']) &&
                           ownEntryOnly(resource.data.get('likes', []), request.resource.data.get('likes', []));

          // The post's author or an admin pins a comment or marks the author's like.
          allow update: if isActiveMember(tourId) &&
                           (get(/databases/$(database)/documents/tours/$(tourId)/posts/$(postId)).data.get('authorEmail', '') == tourUserEmail() || isTourAdmin(tourId)) &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['isPinned', 'isAuthorLiked']);

          // The comment's author, the post's author, or an admin may delete it.
          allow delete: if isActiveMember(tourId) &&
                           (resource.data.get('authorEmail', '') == tourUserEmail() ||
                            get(/databases/$(database)/documents/tours/$(tourId)/posts/$(postId)).data.get('authorEmail', '') == tourUserEmail() ||
                            isTourAdmin(tourId));
        }
      }

      match /stories/{storyId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.authorEmail == tourUserEmail() &&
                         request.resource.data.createdAt == request.time;

        // A member records their own view.
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['viewers']) &&
                         ownEntryOnly(resource.data.get('viewers', []), request.resource.data.get('viewers', []));

        // A member votes once in a poll, for an option that exists.
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['poll']) &&
                         request.resource.data.poll.diff(resource.data.poll).affectedKeys()
                           .hasOnly(['votes']) &&
                         request.resource.data.poll.votes.diff(resource.data.poll.get('votes', {})).affectedKeys()
                           .hasOnly([tourUserEmail()]) &&
                         !(tourUserEmail() in resource.data.poll.get('votes', {})) &&
                         request.resource.data.poll.votes.get(tourUserEmail(), -1) >= 0 &&
                         request.resource.data.poll.votes.get(tourUserEmail(), -1) < resource.data.poll.options.size();

        // A member sets or clears their own reaction.
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['reactions']) &&
                         request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys()
                           .hasOnly([tourUserEmail()]) &&
                         request.resource.data.reactions.get(tourUserEmail(), '').size() <= 16;

        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('authorEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      // Highlights are kept by the member who made them, and by admins.
      match /highlights/{highlightId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.createdByEmail == tourUserEmail();
        allow update, delete: if isActiveMember(tourId) &&
                                 (resource.data.get('createdByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      // Discussion channels. The four built-in channels need no document; admins
      // add more, change a channel's topic, and can limit posting to admins.
      match /channels/{channelId} {
        allow read: if isActiveMember(tourId);
        allow create, update: if isTourAdmin(tourId) &&
                                 request.resource.data.name is string &&
                                 request.resource.data.name.size() <= 40 &&
                                 request.resource.data.topic is string &&
                                 request.resource.data.topic.size() <= 200 &&
                                 request.resource.data.adminOnly is bool;
        allow delete: if isTourAdmin(tourId);

        // Typing signal: each member writes only their own entry.
        match /typing/{typingEmail} {
          allow read: if isActiveMember(tourId);
          allow write: if isActiveMember(tourId) && typingEmail == tourUserEmail();
        }

        // Voice room participants & signaling
        match /voice_participants/{participantEmail} {
          allow read: if isActiveMember(tourId);
          allow write: if isActiveMember(tourId) && participantEmail == tourUserEmail();
        }

        match /voice_signals/{signalId} {
          allow read, write: if isActiveMember(tourId);
          match /candidates/{candId} {
            allow read, write: if isActiveMember(tourId);
          }
        }

        match /messages/{messageId} {
          allow read: if isActiveMember(tourId);

          // Post as yourself, within the text and photo limits. In an admin-only
          // channel, only admins post.
          allow create: if isActiveMember(tourId) &&
                           request.resource.data.senderEmail == tourUserEmail() &&
                           request.resource.data.kind in ['text', 'poll', 'expense'] &&
                           request.resource.data.text is string &&
                           request.resource.data.text.size() <= 1000 &&
                           request.resource.data.get('attachments', []).size() <= 4 &&
                           (isTourAdmin(tourId) ||
                            !(exists(/databases/$(database)/documents/tours/$(tourId)/channels/$(channelId)) &&
                              get(/databases/$(database)/documents/tours/$(tourId)/channels/$(channelId)).data.get('adminOnly', false) == true));

          // The author edits the text and its mentions only.
          allow update: if isActiveMember(tourId) &&
                           resource.data.get('senderEmail', '') == tourUserEmail() &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['text', 'mentions', 'editedAt']) &&
                           request.resource.data.text.size() <= 1000;

          // Admins pin and unpin, and change nothing else.
          allow update: if isTourAdmin(tourId) &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['isPinned', 'pinnedByEmail']);

          // Any member sets or clears their own reaction. Other entries must not change.
          allow update: if isActiveMember(tourId) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
                           request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys()
                             .hasOnly([tourUserEmail()]) &&
                           request.resource.data.reactions.get(tourUserEmail(), '').size() <= 16;

          // Any member votes in a poll, once per poll. Only their own vote changes.
          allow update: if isActiveMember(tourId) &&
                           resource.data.get('pollOptions', []).size() > 0 &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
                           request.resource.data.votes.diff(resource.data.get('votes', {})).affectedKeys()
                             .hasOnly([tourUserEmail()]) &&
                           request.resource.data.votes.get(tourUserEmail(), 0) >= 0 &&
                           request.resource.data.votes.get(tourUserEmail(), 0) < resource.data.get('pollOptions', []).size();

          allow delete: if isActiveMember(tourId) &&
                           (resource.data.get('senderEmail', '') == tourUserEmail() || isTourAdmin(tourId));
        }
      }

      // Live family locations: members read them; each person writes their own.
      match /locations/{locId} {
        allow read: if isActiveMember(tourId);
        allow write: if isActiveMember(tourId) &&
                        request.resource.data.get('email', '') == tourUserEmail();
      }

      match /profiles/{profId} {
        allow read: if isActiveMember(tourId);
        allow write: if isActiveMember(tourId) &&
                        request.resource.data.get('uid', '') == request.auth.uid;
      }

      match /meta/{metaId} {
        allow read: if isActiveMember(tourId);
        allow write: if isTourAdmin(tourId);
      }

      // Shared route stops added on the highway roadmap.
      match /checkpoints/{checkpointId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == tourUserEmail();
        // The author or an admin edits a stop or marks it passed; the author
        // stays the same.
        allow update: if isActiveMember(tourId) &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId)) &&
                         request.resource.data.get('addedByEmail', '') == resource.data.get('addedByEmail', '');
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      // Safety alerts (SOS). A member raises one for themselves, stamped with the
      // server time. The sender or an admin resolves it, and resolving may change
      // only the resolution fields.
      match /sos/{alertId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.senderEmail == tourUserEmail() &&
                         request.resource.data.resolved == false &&
                         request.resource.data.createdAt == request.time;
        allow update: if isActiveMember(tourId) &&
                         (resource.data.senderEmail == tourUserEmail() || isTourAdmin(tourId)) &&
                         request.resource.data.senderEmail == resource.data.senderEmail &&
                         request.resource.data.resolved == true &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['resolved', 'resolvedByEmail', 'resolvedAt']);
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.senderEmail == tourUserEmail() || isTourAdmin(tourId));
      }

      match /bus_seats/{seatId} {
        allow read, write: if isActiveMember(tourId);
      }

      // Buses, trains, flights, launches and the like. Admins set them up.
      match /vehicles/{vehicleId} {
        allow read: if isActiveMember(tourId);
        allow create, update: if isTourAdmin(tourId) &&
                                 request.resource.data.id == vehicleId &&
                                 request.resource.data.rows is int &&
                                 request.resource.data.rows >= 1 &&
                                 request.resource.data.rows <= 40;
        allow delete: if isTourAdmin(tourId);
      }

      // One document per seat, named "<vehicleId>__<seatNumber>". Members
      // change seats unless an admin has locked the vehicle.
      match /vehicle_seats/{seatId} {
        function vehicleLocked(vId) {
          return get(/databases/$(database)/documents/tours/$(tourId)/vehicles/$(vId)).data.get('locked', false) == true;
        }
        allow read: if isActiveMember(tourId);
        allow create, update: if isActiveMember(tourId) &&
                                 seatId == request.resource.data.vehicleId + '__' + request.resource.data.seatNumber &&
                                 exists(/databases/$(database)/documents/tours/$(tourId)/vehicles/$(request.resource.data.vehicleId)) &&
                                 (isTourAdmin(tourId) || !vehicleLocked(request.resource.data.vehicleId)) &&
                                 request.resource.data.keys().hasOnly([
                                   'seatNumber', 'vehicleId', 'assignedMemberEmail',
                                   'assignedMemberName', 'isWindow', 'familySlot']);
        allow delete: if isActiveMember(tourId) &&
                         (isTourAdmin(tourId) || !vehicleLocked(resource.data.vehicleId));
      }

      // Rooms are created and removed by admins; members update guest lists.
      match /hotel_rooms/{roomId} {
        allow read: if isActiveMember(tourId);
        allow create, delete: if isTourAdmin(tourId);
        allow update: if isActiveMember(tourId);
      }

      // Online Game Zone tables for tour group members
      match /games/{gameId} {
        allow read, list: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId);
        allow update: if isActiveMember(tourId);
        allow delete: if isActiveMember(tourId);
      }
    }

    // ---- Invite codes: looked up by exact code only (no listing) ----
    match /invites/{code} {
      allow get: if isAuth();
      allow create: if isAuth() && isOwnerOfTour(request.resource.data.tourId) &&
                       request.resource.data.code == code;
      allow update, delete: if isAuth() && isOwnerOfTour(resource.data.tourId);
    }

    // ---- Memberships ----
    // Each person can read their own rows; members see the roster of their tour.
    match /memberships/{membershipId} {
      allow get: if isAuth() &&
                    (resource == null || resource.data.email == tourUserEmail() || isActiveMember(resource.data.tourId));
      allow list: if isAuth() &&
                     (resource.data.email == tourUserEmail() || isActiveMember(resource.data.tourId));
      // Owners are created with the tour; members join with a valid invite code,
      // or are added directly by an owner or admin.
      allow create: if isAuth() &&
                       membershipId == request.resource.data.tourId + '__' + request.resource.data.email &&
                       request.resource.data.status == 'active' && (
                         (request.resource.data.email == tourUserEmail() &&
                          request.resource.data.role == 'owner' &&
                          isOwnerOfTour(request.resource.data.tourId)) ||
                         (request.resource.data.email == tourUserEmail() &&
                          request.resource.data.role == 'member' &&
                          get(/databases/$(database)/documents/tours/$(request.resource.data.tourId)).data.inviteCode == request.resource.data.joinCode &&
                          !isBanned(request.resource.data.tourId)) ||
                         ((isOwnerOfTour(request.resource.data.tourId) || isTourAdmin(request.resource.data.tourId)) &&
                          request.resource.data.role == 'member' &&
                          !isTargetBanned(request.resource.data.tourId, request.resource.data.email))
                       );
      allow update: if isAuth() &&
                       request.resource.data.tourId == resource.data.tourId &&
                       request.resource.data.email == resource.data.email && (
                         isOwnerOfTour(resource.data.tourId) ||
                         (isTourAdmin(resource.data.tourId) &&
                          request.resource.data.role == 'member' &&
                          !isTargetBanned(resource.data.tourId, resource.data.email)) ||
                         (resource.data.email == tourUserEmail() &&
                          request.resource.data.role == resource.data.role &&
                          request.resource.data.status == resource.data.status &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['displayName', 'photoUrl', 'tourName', 'familyCount', 'uid']))
                       );
      // The owner row can't be removed; ownership moves first. Members can leave.
      allow delete: if isAuth() && (
                       (resource.data.role != 'owner' && (
                         resource.data.email == tourUserEmail() ||
                         isOwnerOfTour(resource.data.tourId) ||
                         (isTourAdmin(resource.data.tourId) && resource.data.role == 'member')
                       )) ||
                       // The owner's own row can only be cleared once the tour is gone.
                       (resource.data.role == 'owner' && resource.data.email == tourUserEmail() &&
                        !exists(/databases/$(database)/documents/tours/$(resource.data.tourId)))
                     );
    }

  }
}
