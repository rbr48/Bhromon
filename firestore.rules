rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()   { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function profile()  {
      return get(/databases/$(database)/documents/explorer_profiles/$(request.auth.uid)).data;
    }
    function isNotUnverified()       { return isAuth(); }
    function isVerifiedOrAbove()     { return isAuth() && profile().tier in ['verified','regionExpert','pioneer']; }
    function isRegionExpertOrAbove() { return isAuth() && profile().tier in ['regionExpert','pioneer']; }
    // The email a person acts under. Only a verified address counts, so nobody can claim
    // a membership, or a chat, by typing someone else's address into their account.
    function tourUserEmail() {
      return (request.auth.token.email != null && request.auth.token.get('email_verified', false) == true)
        ? request.auth.token.email.lower()
        : (request.auth.uid + '@bhromon.app');
    }

    // ---- Field Validation Helpers ----
    // Ensures a timestamp field on the incoming document is not set in the future
    // (prevents timestamp manipulation exploits)
    function notFutureTimestamp(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == request.time ||
             request.resource.data[field] <= request.time;
    }

    // Ensures a string field does not exceed the given character limit
    function maxLength(field, limit) {
      return !(field in request.resource.data) ||
             request.resource.data[field].size() <= limit;
    }

    // Validates that a required field exists and is not empty
    function hasField(field) {
      return field in request.resource.data && request.resource.data[field] != '';
    }

    // Prevents escalation: users cannot write protected tier/badge fields
    function noTierEscalation() {
      return !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['tier', 'isPioneer', 'isRegionExpert', 'explorerScore', 'promotedBy']);
    }

    // Validates a text field length (for anti-spam on free-text inputs)
    function validText(field, minLen, maxLen) {
      return field in request.resource.data &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    // ---- Shared-group contact ----
    // People talk and ring each other only inside a tour they both belong to. A
    // membership row holds a person's email and uid, and its uid can only be
    // written by that person (see the memberships rules), so a uid is tied to an
    // email the rules can check.
    function groupRow(tId, email) {
      return /databases/$(database)/documents/memberships/$(tId + '__' + email);
    }
    function activeMemberBound(tId, uid, emails) {
      return uid in emails
        && exists(groupRow(tId, emails[uid]))
        && get(groupRow(tId, emails[uid])).data.status == 'active'
        && get(groupRow(tId, emails[uid])).data.uid == uid;
    }
    // `data` is a chat or a call: its two uids, the tour they share, and each uid's email.
    function sharesGroup(data) {
      return isAuth()
        && data.keys().hasAll(['participants', 'sharedTourId', 'memberEmails'])
        && data.sharedTourId.matches('^[A-Za-z0-9_-]{1,64}$')
        && data.participants.size() == 2
        && request.auth.uid in data.participants
        && data.memberEmails[request.auth.uid] == tourUserEmail()
        && activeMemberBound(data.sharedTourId, data.participants[0], data.memberEmails)
        && activeMemberBound(data.sharedTourId, data.participants[1], data.memberEmails);
    }
    // A chat notice may reach the other person of a chat that is open between members of one tour.
    function chatNoticeAllowed(recipientUid) {
      return request.resource.data.action == 'chat'
        && exists(/databases/$(database)/documents/chats/$(request.resource.data.itemId))
        && get(/databases/$(database)/documents/chats/$(request.resource.data.itemId)).data.participants.hasAll([recipientUid])
        && sharesGroup(get(/databases/$(database)/documents/chats/$(request.resource.data.itemId)).data);
    }

    // ---- Location Pins ----
    // Pins are listed by admins only; anyone signed in can open one by its ID.
    match /location_pins/{id} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    // ---- Trip Logs (diaries) ----
    // A diary belongs to its author. Nobody else reads one, and a list can only be
    // the author's own diaries, so other people's diaries cannot be browsed.
    match /trip_logs/{id} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    // ---- Archived Trip Logs ----
    match /archived_trip_logs/{id} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    // ---- Pro Tips ----
    match /pro_tips/{id} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    match /explorer_profiles/{uid} {
      // A profile opens by its user ID. Profiles cannot be listed, so there is no
      // directory of people; group members are found through their memberships.
      allow get: if isAuth();
      allow list: if false;
      allow create: if isOwner(uid)
                    && (!('tier' in request.resource.data) || request.resource.data.tier == 'unverified')
                    && (!('isPioneer' in request.resource.data) || request.resource.data.isPioneer == false)
                    && (!('isRegionExpert' in request.resource.data) || request.resource.data.isRegionExpert == false)
                    && (!('badges' in request.resource.data) || request.resource.data.badges.size() == 0)
                    && (!('explorerScore' in request.resource.data) || (request.resource.data.explorerScore.value == 0 && request.resource.data.explorerScore.tier == 'unverified'))
                    && (!('promotedBy' in request.resource.data));
      allow update: if (isOwner(uid)
                    && !request.resource.data.diff(resource.data)
                       .affectedKeys().hasAny(['tier','badges','isPioneer','isRegionExpert','explorerScore','promotedBy']))
                    || (isRegionExpertOrAbove()
                       && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['tier','badges','isPioneer','isRegionExpert','explorerScore','promotedBy','updatedAt']));
      allow delete: if isOwner(uid);

      match /blocked_users/{blockedUid} {
        allow read: if isAuth() && (isOwner(uid) || request.auth.uid == blockedUid);
        allow write: if isAuth() && isOwner(uid);
      }

      // ---- Saved Diaries ----
      match /saved_diaries/{tripLogId} {
        // Retired: the travel product is gone. The data is kept, and no client can read or write it.
        allow read, write: if false;
      }

      // ---- Bucket List ----
      match /bucket_list/{itemId} {
        // Retired: the travel product is gone. The data is kept, and no client can read or write it.
        allow read, write: if false;
      }
    }

    // ---- Content Reports ----
    match /travel_log_reports/{id} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    // ---- Explorer Scores ----
    match /explorer_scores/{uid} {
      allow get:   if isAuth();
      allow list:  if false;
      allow write: if false;
    }

    // ---- Trust Events ----
    match /trust_events/{id} {
      allow create: if isAuth()
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.timestamp == request.time
                    && (
                      (request.resource.data.type == 'trip_published' && request.resource.data.weight == 25) ||
                      (request.resource.data.type == 'endorsement' && request.resource.data.weight == 10) ||
                      (request.resource.data.type == 'helpful_vote' && request.resource.data.weight == 5) ||
                      (request.resource.data.type == 'spam_flag' && (request.resource.data.weight == -5 || request.resource.data.weight == 1)) ||
                      (request.resource.data.type == 'safety_flag' && (request.resource.data.weight == -5 || request.resource.data.weight == 1)) ||
                      isRegionExpertOrAbove()
                    );
      allow read, update, delete: if false;
    }

    // ---- Flag Appeals ----
    match /flag_appeals/{id} {
      allow create: if isAuth() && request.resource.data.appellantUid == request.auth.uid;
      allow read:   if isAuth() && (isOwner(resource.data.appellantUid) || isRegionExpertOrAbove());
      allow update: if isRegionExpertOrAbove();
      allow delete: if false;
    }

    // ---- FCM Tokens ----
    match /fcm_tokens/{uid} {
      allow read, write: if isOwner(uid);

      // One document per signed-in device. Written by that user's app only.
      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- App Config (read by app, write by admin web only via service account) ----
    match /app_config/{id} {
      allow read: if true;
      allow write: if isRegionExpertOrAbove();
    }

    // ---- Suggested Pins (users submit; admins review) ----
    match /suggested_pins/{id} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    // ---- Push Notifications (admin sends, all users read own) ----
    match /notifications/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isRegionExpertOrAbove();
    }

    // ---- Admin Audit Logs (write-only by auth; read by admins) ----
    match /admin_audit_logs/{id} {
      allow create: if isRegionExpertOrAbove();
      allow read:   if isRegionExpertOrAbove();
      allow update, delete: if false;
    }

    // ---- Direct Messages (admin writes to inbox; user reads own inbox) ----
    match /direct_messages/{uid}/inbox/{msgId} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    // ---- Follows ----
    match /follows/{id} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    // ---- Likes ----
    match /likes/{id} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    // ---- Pin Visits ----
    match /pin_visits/{id} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    // ---- Safety Reports ----
    // Signed-in reporters only. The reporter is the caller, the report starts
    // pending, and the timestamp is the server's clock.
    match /safety_reports/{id} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    // ---- Geo Fence Triggers ----
    // Written by the device when a signed-in user enters a pin's area. Only the
    // fields the function reads are accepted, with the server's clock.
    match /geo_fence_triggers/{id} {
      // Retired: the travel product is gone. The data is kept, and no client can read or write it.
      allow read, write: if false;
    }

    // ---- Users ----
    // A user's account record is private to them; admins may read it for moderation.
    match /users/{uid} {
      allow read: if isOwner(uid) || isRegionExpertOrAbove();
      allow write: if isOwner(uid);

      match /badges/{id} {
        allow read: if isOwner(uid) || isRegionExpertOrAbove();
        allow write: if isOwner(uid);
      }

      match /wishlist/{id} {
        allow read: if isOwner(uid) || isRegionExpertOrAbove();
        allow write: if isOwner(uid);
      }

      match /trust_history/{id} {
        allow read: if isOwner(uid) || isRegionExpertOrAbove();
        allow write: if isOwner(uid);
      }

      // Someone else may leave a notice only as a chat notice to a person they share
      // a tour with, for a chat that is open between them.
      match /notifications/{id} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isAuth()
                      && request.resource.data.timestamp == request.time
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && (isOwner(uid) || chatNoticeAllowed(uid));
      }
    }

    // ── End-to-end encryption keys (E2EE_DESIGN.md, sections 6 and 7) ─────────
    // A device publishes its identity key and the signed one-time and fallback keys that
    // others use to start a session with it. The keys are public, so any signed-in user reads
    // them. Only the owner writes them, and only well-formed keys. A key is 32 bytes and a
    // signature is 64 bytes, both base64url. Padding is allowed.
    match /e2ee_keys/{uid} {
      function isKey(v) { return v is string && v.matches('^[A-Za-z0-9_-]{43}=?$'); }
      function isSig(v) { return v is string && v.matches('^[A-Za-z0-9_-]{86}(==)?$'); }
      function isDevice(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,64}$'); }
      function isKeyId(v) { return v is string && v.matches('^[A-Za-z0-9_-]{22}$'); }
      function isSignedKey(k) {
        return k is map
          && k.keys().hasOnly(['keyId', 'key', 'signature'])
          && k.keys().hasAll(['keyId', 'key', 'signature'])
          && isKeyId(k.keyId) && isKey(k.key) && isSig(k.signature);
      }
      function isBundle(d) {
        return d.keys().hasOnly(['deviceId', 'curve25519Key', 'ed25519Key', 'identitySignature', 'fallbackKey', 'updatedAt'])
          && d.keys().hasAll(['deviceId', 'curve25519Key', 'ed25519Key', 'identitySignature', 'updatedAt'])
          && isDevice(d.deviceId)
          && isKey(d.curve25519Key) && isKey(d.ed25519Key) && isSig(d.identitySignature)
          && d.updatedAt == request.time
          && (!('fallbackKey' in d) || isSignedKey(d.fallbackKey));
      }

      allow read:          if isAuth();
      allow create, update: if isOwner(uid) && isBundle(request.resource.data);
      allow delete:        if isOwner(uid);

      // A one-time key is used once. A sender claims an unclaimed key before it starts a
      // session from it, so two senders never start from the same key. The owner removes
      // the key after the first message that uses it.
      match /oneTimeKeys/{keyId} {
        function isOneTimeKey(d) {
          return d.keys().hasOnly(['deviceId', 'keyId', 'key', 'signature', 'claimedBy'])
            && d.keys().hasAll(['deviceId', 'keyId', 'key', 'signature', 'claimedBy'])
            && isDevice(d.deviceId) && isKeyId(d.keyId) && d.keyId == keyId
            && isKey(d.key) && isSig(d.signature) && d.claimedBy == null;
        }
        allow read:   if isAuth();
        allow create: if isOwner(uid) && isKeyId(keyId) && isOneTimeKey(request.resource.data);
        // Any signed-in user may claim a key nobody has claimed, once. The claim sets the
        // claimer's uid and the server time, and nothing else changes.
        allow update: if isAuth()
          && resource.data.claimedBy == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt'])
          && request.resource.data.claimedBy == request.auth.uid
          && request.resource.data.claimedAt == request.time;
        allow delete: if isOwner(uid);
      }
    }

    // ── Chats & Messages ────────────────────────────────────────────────────
    // Chat document ID format: "{uid1}_{uid2}" (or email identifiers).
    // Participants can be matched by UID, email, or by the participants array.
    match /chats/{chatId} {
      function isParticipant() {
        return isAuth() && (
          chatId.matches('^' + request.auth.uid + '_.*') ||
          chatId.matches('.*_' + request.auth.uid + '$') ||
          chatId.matches('^' + tourUserEmail() + '_.*') ||
          chatId.matches('.*_' + tourUserEmail() + '$') ||
          (request.auth.token.email != null && request.auth.token.get('email_verified', false) == true && (
            chatId.matches('^' + request.auth.token.email + '_.*') ||
            chatId.matches('.*_' + request.auth.token.email + '$')
          )) ||
          (resource != null && 'participants' in resource.data && (
            request.auth.uid in resource.data.participants ||
            tourUserEmail() in resource.data.participants
          ))
        );
      }

      // Chat metadata. Only participants read or update it. A chat opens, and its
      // people change, only between two active members of one tour they share.
      allow read:   if isParticipant();
      // An encrypted chat is created with e2ee: true. The flag is set once and cannot change.
      allow create: if sharesGroup(request.resource.data)
                    && (!('e2ee' in request.resource.data) || request.resource.data.e2ee is bool);
      allow update: if isParticipant()
                    // Metadata (lastMessage, lastMessageTime, typing_*, etc.) changes freely.
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharedTourId', 'memberEmails'])
                      || sharesGroup(request.resource.data)
                    )
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants'])
                      || sharesGroup(request.resource.data)
                    )
                    // The encryption flag is set at creation and cannot change afterwards.
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['e2ee']);
      allow delete: if false;

      match /messages/{messageId} {
        // Validate outgoing messages: sender must be the authenticated user,
        // type must be a known value, and message text has no maximum length limit.
        function validMessage() {
          let d = request.resource.data;
          return (d.senderId == request.auth.uid || d.senderId == tourUserEmail())
              && d.type in ['text', 'image', 'video', 'audio', 'document', 'location', 'contact', 'deleted', 'call', 'expense']
              && (!('text' in d) || d.text == null || d.text is string)
              && ('timestamp' in d && d.timestamp == request.time);
        }

        function isParentParticipant() {
          return isAuth() && (
            isParticipant() ||
            (
              exists(/databases/$(database)/documents/chats/$(chatId)) &&
              (
                request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
                tourUserEmail() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
              )
            )
          );
        }

        // Messages are read and written only while the chat is open between two
        // members of one tour.
        function parentShared() {
          return exists(/databases/$(database)/documents/chats/$(chatId)) &&
                 sharesGroup(get(/databases/$(database)/documents/chats/$(chatId)).data);
        }

        // An encrypted chat's message carries an envelope, the outer wrapper of the encrypted
        // text (E2EE_DESIGN.md, section 7). The rules check its shape and size. The server checks
        // the bytes.
        function isDeviceId(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,64}$'); }
        function isEnvelope(e) {
          return e is map
            && e.keys().hasOnly(['v', 'alg', 'from', 'to', 'type', 'ct'])
            && e.keys().hasAll(['v', 'alg', 'from', 'to', 'type', 'ct'])
            && e.v == 1
            && e.alg == 'olm.v1'
            && (e.type == 0 || e.type == 1)
            && isDeviceId(e.from) && isDeviceId(e.to)
            && e.ct is string && e.ct.size() > 0 && e.ct.size() <= 21848
            && e.ct.matches('^[A-Za-z0-9_-]+={0,2}$');
        }
        function chatE2ee() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.get('e2ee', false) == true;
        }
        // An encrypted chat takes only a text message whose content is an envelope. A plaintext
        // chat takes no envelope.
        function validContent() {
          let d = request.resource.data;
          return chatE2ee()
            ? (d.type == 'text' && isEnvelope(d.get('envelope', null)) && (!('text' in d) || d.text == null))
            : !('envelope' in d);
        }

        allow read:   if isParentParticipant() && parentShared();
        allow create: if isParentParticipant() && parentShared() && validMessage() && validContent();
        // Allow updates for delivery receipts, reactions, edits, Delete for Me, and Delete for Everyone.
        // In an encrypted chat only receipts and Delete for Me change a message: the other changes
        // carry content, and the first slice leaves them out (E2EE_DESIGN.md, section 8).
        allow update: if isParentParticipant() && parentShared()
                      && (
                        // Recipient marking seen or delivered
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'status', 'deliveredAt', 'readAt'])
                         && request.auth.uid != resource.data.senderId)
                        // Participant adding own UID to deletedFor array ("Delete for Me")
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
                            && request.auth.uid in request.resource.data.deletedFor)
                        // Participant adding or changing their own reaction
                        || (!chatE2ee() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
                        // Sender editing their own text message within 15 minutes
                        || (!chatE2ee() && request.auth.uid == resource.data.senderId
                            && resource.data.type == 'text'
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt'])
                            && request.resource.data.isEdited == true
                            && request.time < resource.data.timestamp + duration.value(15, 'm'))
                        // Sender tombstoning their own message ("Delete for Everyone") within 60 hours
                        || (!chatE2ee() && request.auth.uid == resource.data.senderId
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'text', 'isDeleted', 'deletedAt'])
                            && request.resource.data.type == 'deleted'
                            && request.resource.data.isDeleted == true
                            && request.time < resource.data.timestamp + duration.value(60, 'h'))
                        // Star toggle for participant
                        || (!chatE2ee() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isStarred', 'starredBy']))
                        // View-once media opened mark
                        || (!chatE2ee() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOpened', 'openedAt']))
                        // Travel expense split settlement
                        || (!chatE2ee() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSettled']))
                      );
        allow delete: if false;
      }
    }

    // ── WebRTC Calling & Signaling ───────────────────────────────────────────
    // A call is a document between two parties. The caller creates it, and that
    // write rings the callee (sendCallPushNotification). After creation the
    // identity fields are fixed. The only moves left are the ones a call makes:
    // answer, decline, miss, or end. Candidates carry each device's network
    // addresses, so only the two parties can read them.
    match /calls/{callId} {
      function isCaller(data) {
        return request.auth.uid == data.callerId || tourUserEmail() == data.callerId;
      }
      function isCallee(data) {
        return request.auth.uid == data.calleeId || tourUserEmail() == data.calleeId;
      }
      function isParty(data) {
        return isCaller(data) || isCallee(data);
      }
      function isSdp(description, sdpType) {
        return description is map
          && description.keys().hasOnly(['type', 'sdp'])
          && description.type == sdpType
          && description.sdp is string
          && description.sdp.size() <= 65536;
      }
      function isCandidate(data) {
        return data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex'])
          && data.candidate is string
          && data.candidate.size() <= 2048;
      }

      allow read: if isAuth() && resource != null && isParty(resource.data);

      allow create: if isAuth()
        && isCaller(request.resource.data)
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId.size() > 0
        && request.resource.data.calleeId.size() <= 128
        && request.resource.data.calleeId != request.resource.data.callerId
        && request.resource.data.participants.hasAll([request.resource.data.callerId, request.resource.data.calleeId])
        && sharesGroup(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'callerId', 'calleeId', 'participants', 'isVideo', 'sharedTourId', 'memberEmails',
          'callerName', 'callerAvatar', 'offer', 'status', 'createdAt'
        ])
        && request.resource.data.isVideo is bool
        && request.resource.data.status == 'calling'
        && request.resource.data.createdAt == request.time
        && isSdp(request.resource.data.offer, 'offer')
        && maxLength('callerName', 80)
        && maxLength('callerAvatar', 512);

      // Moves the status from one of `fromStatuses` to `newStatus`, leaving the answer alone.
      function movesTo(newStatus, fromStatuses) {
        return request.resource.data.status == newStatus
          && resource.data.status in fromStatuses
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['answer']);
      }

      allow update: if isAuth()
        && resource != null
        && isParty(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'answer', 'endedAt', 'durationSeconds'])
        && (!('endedAt' in request.resource.data) || request.resource.data.endedAt == request.time)
        && (!('durationSeconds' in request.resource.data) || request.resource.data.durationSeconds is int)
        && (
          // The callee answers a ringing call. The status and the SDP answer change together.
          (request.resource.data.status == 'answered'
            && resource.data.status == 'calling'
            && isCallee(resource.data)
            && isSdp(request.resource.data.answer, 'answer'))
          // The callee declines a ringing call.
          || (isCallee(resource.data) && movesTo('declined', ['calling']))
          // The caller gives up on a call that nobody answered.
          || (isCaller(resource.data) && movesTo('missed', ['calling']))
          // Either party hangs up a call that is ringing or in progress.
          || movesTo('ended', ['calling', 'answered'])
        );

      allow delete: if false;

      match /offerCandidates/{candidateId} {
        allow read: if isAuth() && isParty(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if isAuth()
          && isCaller(get(/databases/$(database)/documents/calls/$(callId)).data)
          && isCandidate(request.resource.data);
        allow update, delete: if false;
      }

      match /answerCandidates/{candidateId} {
        allow read: if isAuth() && isParty(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if isAuth()
          && isCallee(get(/databases/$(database)/documents/calls/$(callId)).data)
          && isCandidate(request.resource.data);
        allow update, delete: if false;
      }
    }

    // ── Rate-Limit Violations (written by Cloud Functions, read by admins) ──
    match /rate_limit_violations/{uid} {
      allow read:   if isRegionExpertOrAbove();
      allow write:  if false; // Only Cloud Functions service account may write
    }

    // ── Tour Groups & Memberships (Family Bhromon Engine) ───────────────────
    // ---- Tour Group helpers ----
    // Membership docs are keyed `{tourId}__{email}`. get() and exists() bypass
    // read rules, so these helpers can inspect any tour's membership.
    function tourMemberPath(tId) {
      return /databases/$(database)/documents/memberships/$(tId + '__' + tourUserEmail());
    }
    function isActiveMember(tId) {
      return isAuth() && (
        isOwnerOfTour(tId) ||
        (exists(tourMemberPath(tId)) && get(tourMemberPath(tId)).data.status == 'active')
      );
    }
    function isTourAdmin(tId) {
      return isOwnerOfTour(tId) ||
             (isActiveMember(tId) && exists(tourMemberPath(tId)) && get(tourMemberPath(tId)).data.role in ['admin', 'owner']);
    }
    function isOwnerOfTour(tId) {
      return isAuth() && exists(/databases/$(database)/documents/tours/$(tId)) &&
             (get(/databases/$(database)/documents/tours/$(tId)).data.ownerUid == request.auth.uid ||
              get(/databases/$(database)/documents/tours/$(tId)).data.ownerEmail == tourUserEmail());
    }
    function isBanned(tId) {
      return exists(/databases/$(database)/documents/tours/$(tId)/bans/$(tourUserEmail()));
    }
    function isTargetBanned(tId, email) {
      return exists(/databases/$(database)/documents/tours/$(tId)/bans/$(email));
    }
    // A family circle starts without a trip. Tours saved before `kind` existed are trips.
    function isFamilyTour(tId) {
      return exists(/databases/$(database)/documents/tours/$(tId)) &&
             get(/databases/$(database)/documents/tours/$(tId)).data.get('kind', 'tour') == 'family';
    }
    // An office or a campus is a family-style circle where only admins write notices.
    // ------------------------------------------------------------------------
    // MFS (bKash / Nagad / Rocket / Upay) validation for payments and settlements.
    // ------------------------------------------------------------------------
    function validMfsProvider(provider) {
      return provider in ['cash', 'bkash', 'nagad', 'rocket', 'upay', 'bankTransfer'];
    }

    function validMfsTrxId(provider, trxId) {
      return provider == 'cash'
        ? (trxId == null || trxId == '')
        : (
            trxId is string &&
            trxId.matches('^[A-Z0-9]{8,14}$') &&
            (provider != 'bkash' || trxId.size() == 10)
          );
    }

    function validMfsInfo(mfs, tId) {
      return mfs is map &&
        mfs.keys().hasOnly([
          'provider',
          'trxId',
          'senderMaskedPhone',
          'receiverMaskedPhone',
          'feePaisa',
          'feeAbsorbedByGroup',
          'status',
          'verifiedByUserId',
          'verifiedByName',
          'verifiedAt',
          'disputeReason'
        ]) &&
        validMfsProvider(mfs.get('provider', '')) &&
        validMfsTrxId(mfs.get('provider', ''), mfs.get('trxId', null)) &&
        mfs.get('feePaisa', 0) is int &&
        mfs.get('feePaisa', 0) >= 0 &&
        mfs.get('feeAbsorbedByGroup', false) is bool &&
        mfs.get('status', 'unverified') in ['unverified', 'verified', 'disputed'];
    }

    // Validates optional `mfsInfo` map on expenses, deposits, transfers, or samity_payments.
    function validOptionalMfsInfo(data, tId) {
      return !('mfsInfo' in data) ||
        data.mfsInfo == null ||
        validMfsInfo(data.mfsInfo, tId);
    }

    // On CREATE: Non-admin members can only submit MFS transactions as 'unverified'
    // (unless paying via 'cash'). Only tour admins/managers can immediately mark 'verified'.
    function canVerifyMfsOnCreate(data, tId) {
      return !('mfsInfo' in data) ||
        data.mfsInfo == null ||
        data.mfsInfo.get('provider', 'cash') == 'cash' ||
        data.mfsInfo.get('status', 'unverified') == 'unverified' ||
        isTourAdmin(tId);
    }

    // On UPDATE, a member (the record's author or payer) may edit an MFS record only while it is
    // unverified, and may never change its status. Once an admin verifies or disputes a record it is
    // frozen for members, so the TrxID and amount the admin checked stay as they are. Admins are
    // allowed separately by each rule, so this check does not look up memberships.
    function memberMayEditMfs(beforeData, afterData) {
      let oldStatus = ('mfsInfo' in beforeData && beforeData.mfsInfo != null)
        ? beforeData.mfsInfo.get('status', 'unverified')
        : 'unverified';
      let newStatus = ('mfsInfo' in afterData && afterData.mfsInfo != null)
        ? afterData.mfsInfo.get('status', 'unverified')
        : 'unverified';
      return oldStatus == 'unverified' && newStatus == 'unverified';
    }

    function isManagedTour(tId) {
      return exists(/databases/$(database)/documents/tours/$(tId)) &&
             get(/databases/$(database)/documents/tours/$(tId)).data.get('preset', '') in ['office', 'campus'];
    }
    // An office, a campus, a mess, a housing society or a samity: the owner and admins post
    // the notices and members answer them.
    function hasManagedNotices(tId) {
      return exists(/databases/$(database)/documents/tours/$(tId)) &&
             get(/databases/$(database)/documents/tours/$(tId)).data.get('preset', '') in ['office', 'campus', 'mess', 'society', 'samity', 'school', 'sports', 'committee'];
    }
    // Moments is on unless an office or a campus has turned it off.
    function momentsOpen(tId) {
      return exists(/databases/$(database)/documents/tours/$(tId)) &&
             (!isManagedTour(tId) || get(/databases/$(database)/documents/tours/$(tId)).data.get('momentsEnabled', true) != false);
    }
    // A mess or shared home is a family circle with the mess preset.
    function isMessTour(tId) {
      return exists(/databases/$(database)/documents/tours/$(tId)) &&
             get(/databases/$(database)/documents/tours/$(tId)).data.get('preset', '') == 'mess';
    }
    // A housing society and a samity are family circles with their own preset.
    function isSocietyTour(tId) {
      return exists(/databases/$(database)/documents/tours/$(tId)) &&
             get(/databases/$(database)/documents/tours/$(tId)).data.get('preset', '') in ['society', 'committee'];
    }
    function isSamityTour(tId) {
      return exists(/databases/$(database)/documents/tours/$(tId)) &&
             get(/databases/$(database)/documents/tours/$(tId)).data.get('preset', '') == 'samity';
    }
    // A family circle with any preset (office, campus, mess, society or samity) is not a
    // household.
    function hasPreset(tId) {
      return exists(/databases/$(database)/documents/tours/$(tId)) &&
             get(/databases/$(database)/documents/tours/$(tId)).data.get('preset', '') != '';
    }
    // A household is a plain family circle with no preset. Dependents and family dates are
    // for households only.
    function isHouseholdTour(tId) {
      return isFamilyTour(tId) && !hasPreset(tId);
    }
    // Shared shopping and to-do lists also serve a mess, so they follow the family
    // rule: any family circle that is not an office or a campus.
    function isSharedListTour(tId) {
      return isFamilyTour(tId) && !isManagedTour(tId);
    }

    // A study or book club: a family circle with the study preset. Any member proposes a
    // book, which an admin lists or declines; its reading plan is open to every member.
    function isStudyTour(tId) {
      return isFamilyTour(tId) &&
             get(/databases/$(database)/documents/tours/$(tId)).data.get('preset', '') == 'study';
    }

    // A family date: a birthday, bill, school or medicine time. Days are YYYY-MM-DD
    // strings, and the reminder days are 0 to 30 (the app offers a few of them).
    function isDayKey(v) {
      return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    // A samity's schedule on the tour: what each member pays (up to one million taka), the
    // first month, the due day (1 to 28) and at most 200 members in the payout order.
    function validSamityConfig(s) {
      return s is map &&
             s.keys().hasOnly(['contributionTaka', 'startMonth', 'dueDay', 'payoutOrder']) &&
             s.contributionTaka is int && s.contributionTaka >= 0 && s.contributionTaka <= 1000000 &&
             s.dueDay is int && s.dueDay >= 1 && s.dueDay <= 28 &&
             (s.get('startMonth', null) == null || (s.startMonth is string && s.startMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'))) &&
             s.payoutOrder is list && s.payoutOrder.size() <= 200;
    }

    // A shared shopping or to-do item in a family circle.
    function validFamilyTask(d) {
      return d.keys().hasOnly(['title', 'kind', 'done', 'assigneeEmail', 'doneByEmail', 'createdByEmail']) &&
             d.title is string && d.title.size() >= 1 && d.title.size() <= 120 &&
             d.kind in ['shopping', 'todo'] &&
             d.done is bool &&
             (d.get('assigneeEmail', null) == null || (d.assigneeEmail is string && d.assigneeEmail.size() <= 254)) &&
             (d.get('doneByEmail', null) == null || (d.doneByEmail is string && d.doneByEmail.size() <= 254)) &&
             d.createdByEmail is string;
    }
    // A book on a study group's list: a title, an optional author and note, one of three
    // statuses, and an approval. A member's book is proposed until an admin lists it or
    // declines it with a note. A book with no approval was listed before approvals existed.
    function validStudyBook(d) {
      return d.keys().hasOnly(['title', 'author', 'notes', 'status', 'statusByEmail', 'createdByEmail', 'approval', 'declineNote']) &&
             d.title is string && d.title.size() >= 1 && d.title.size() <= 120 &&
             (d.get('author', null) == null || (d.author is string && d.author.size() <= 120)) &&
             (d.get('notes', null) == null || (d.notes is string && d.notes.size() <= 500)) &&
             d.status in ['toRead', 'reading', 'finished'] &&
             (d.get('statusByEmail', null) == null || (d.statusByEmail is string && d.statusByEmail.size() <= 254)) &&
             (d.get('approval', null) == null || d.approval in ['proposed', 'listed', 'declined']) &&
             (d.get('declineNote', null) == null || (d.declineNote is string && d.declineNote.size() <= 300)) &&
             d.createdByEmail is string && d.createdByEmail.size() <= 254;
    }
    // Whether a book is on the group's list. A book with no approval is, as it was before
    // approvals existed.
    function studyBookListed(d) {
      return d.get('approval', 'listed') == 'listed';
    }
    // A study subject: a name, an optional course code, description and exam date, and an
    // approval like a book's.
    function validStudySubject(d) {
      return d.keys().hasOnly(['title', 'code', 'description', 'examDate', 'approval', 'declineNote', 'createdByEmail']) &&
             d.title is string && d.title.size() >= 1 && d.title.size() <= 80 &&
             (d.get('code', null) == null || (d.code is string && d.code.size() <= 20)) &&
             (d.get('description', null) == null || (d.description is string && d.description.size() <= 300)) &&
             (d.get('examDate', null) == null || d.examDate is timestamp) &&
             (d.get('approval', null) == null || d.approval in ['proposed', 'listed', 'declined']) &&
             (d.get('declineNote', null) == null || (d.declineNote is string && d.declineNote.size() <= 300)) &&
             d.createdByEmail is string && d.createdByEmail.size() <= 254;
    }
    // The modules a study subject can turn on. Only these are live; the rest are coming.
    function studyModuleLive(key) {
      return key in ['tips', 'suggestions'];
    }
    // A module's settings: on or off, its name, and who may post in it.
    function validStudyModule(d) {
      return d.keys().hasOnly(['enabled', 'name', 'postPolicy']) &&
             d.enabled is bool &&
             d.name is string && d.name.size() >= 1 && d.name.size() <= 40 &&
             d.postPolicy in ['members', 'admins', 'approval'];
    }
    // A tip or a suggestion: its text, an optional title and an optional https link, how many
    // members found it helpful, and whether it is shown and pinned.
    function validStudyPost(d) {
      return d.keys().hasOnly(['text', 'title', 'url', 'createdByEmail', 'createdAt', 'helpfulCount', 'shown', 'pinned']) &&
             d.text is string && d.text.size() >= 1 && d.text.size() <= 1000 &&
             (d.get('title', null) == null || (d.title is string && d.title.size() <= 120)) &&
             (d.get('url', null) == null || (d.url is string && d.url.size() <= 500 && d.url.matches('https://.*'))) &&
             d.createdByEmail is string && d.createdByEmail.size() <= 254 &&
             d.createdAt is timestamp &&
             d.helpfulCount is int && d.helpfulCount >= 0 &&
             d.shown is bool && d.pinned is bool;
    }
    // Whether an update to a subject is allowed. Only an admin changes whether it is listed;
    // its creator or an admin changes the details.
    function studySubjectUpdateAllowed(tourId, newData, oldData) {
      let byAdmin = isTourAdmin(tourId);
      return (byAdmin || newData.get('approval', 'listed') == oldData.get('approval', 'listed')) &&
             (newData.get('declineNote', null) == null || newData.get('approval', null) == 'declined') &&
             (byAdmin || oldData.get('createdByEmail', '') == tourUserEmail());
    }
    // Whether a module of a subject is on: its settings exist and say so.
    function studyModuleOn(tourId, subjectId, moduleKey) {
      return exists(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/modules/$(moduleKey)) &&
             get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/modules/$(moduleKey)).data.enabled == true;
    }
    // Whether a subject is listed, so that its modules can be used.
    function studySubjectListed(tourId, subjectId) {
      return get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)).data.get('approval', 'listed') == 'listed';
    }
    // Whether a member may add a post to a module of a listed subject, and how it is shown: an
    // admin's post always is; a member's post is shown when the module lets members post directly.
    function studyPostCreateAllowed(tourId, subjectId, moduleKey, d) {
      let byAdmin = isTourAdmin(tourId);
      return isStudyTour(tourId) && isActiveMember(tourId) &&
             d.createdByEmail == tourUserEmail() &&
             d.helpfulCount == 0 && d.pinned == false && d.createdAt == request.time &&
             validStudyPost(d) &&
             studySubjectListed(tourId, subjectId) &&
             studyModuleOn(tourId, subjectId, moduleKey) &&
             (byAdmin || get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/modules/$(moduleKey)).data.postPolicy != 'admins') &&
             d.shown == (byAdmin || get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/modules/$(moduleKey)).data.postPolicy == 'members');
    }
    // The signed-in member's own helpful mark on a post: whether it is there now, and whether
    // it will be there once the batch being written has been applied.
    function studyMarkNow(tourId, subjectId, moduleKey, postId) {
      return exists(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/$(moduleKey)/$(postId)/helpful/$(tourUserEmail()));
    }
    function studyMarkAfter(tourId, subjectId, moduleKey, postId) {
      return existsAfter(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/$(moduleKey)/$(postId)/helpful/$(tourUserEmail()));
    }
    // Whether an update to a post is allowed. A member's mark moves the count by one, and the
    // mark is written or removed in the same batch: a count that rises needs this member's mark
    // to exist after the write, and one that falls needs it gone after the write. Its author
    // changes the words. An admin shows it or pins it.
    function studyPostUpdateAllowed(tourId, subjectId, moduleKey, postId, newData, oldData) {
      let byAdmin = isTourAdmin(tourId);
      let changed = newData.diff(oldData).affectedKeys();
      return newData.createdByEmail == oldData.createdByEmail &&
             validStudyPost(newData) &&
             ((changed.hasOnly(['helpfulCount']) &&
               ((newData.helpfulCount - oldData.helpfulCount == 1 &&
                 !studyMarkNow(tourId, subjectId, moduleKey, postId) &&
                 studyMarkAfter(tourId, subjectId, moduleKey, postId)) ||
                (oldData.helpfulCount - newData.helpfulCount == 1 &&
                 studyMarkNow(tourId, subjectId, moduleKey, postId) &&
                 !studyMarkAfter(tourId, subjectId, moduleKey, postId)))) ||
              ((byAdmin || oldData.createdByEmail == tourUserEmail()) &&
               (byAdmin || changed.hasOnly(['text', 'title', 'url']))));
    }

    // Whether an update to a study book is allowed. The admin check reads the member record,
    // so it is made once here, and the cheaper checks come first.
    function studyBookUpdateAllowed(tourId, newData, oldData) {
      let byAdmin = isTourAdmin(tourId);
      return newData.createdByEmail == oldData.createdByEmail &&
             validStudyBook(newData) &&
             // Only an admin lists a book or declines it.
             (newData.get('approval', 'listed') == oldData.get('approval', 'listed') || byAdmin) &&
             // A declined book keeps its note, and no other book has one.
             (newData.get('declineNote', null) == null || newData.get('approval', null) == 'declined') &&
             ((newData.diff(oldData).affectedKeys().hasOnly(['status', 'statusByEmail']) &&
               newData.get('statusByEmail', null) == tourUserEmail() &&
               studyBookListed(oldData) && studyBookListed(newData)) ||
              ((byAdmin || oldData.get('createdByEmail', '') == tourUserEmail()) &&
               (newData.status == oldData.status ||
                (newData.get('statusByEmail', null) == tourUserEmail() && studyBookListed(newData)))));
    }
    // A chapter of a book: its number, title, optional page range, optional due date, and up to
    // five guide questions. Admins set chapters.
    function validStudyChapter(d) {
      return d.keys().hasOnly(['number', 'title', 'pageFrom', 'pageTo', 'dueOn', 'guide']) &&
             d.number is int && d.number >= 1 && d.number <= 500 &&
             d.title is string && d.title.size() >= 1 && d.title.size() <= 120 &&
             (d.get('pageFrom', null) == null || (d.pageFrom is int && d.pageFrom >= 1 && d.pageFrom <= 5000)) &&
             (d.get('pageTo', null) == null || (d.pageTo is int && d.pageTo >= 1 && d.pageTo <= 5000)) &&
             ((d.get('pageFrom', null) == null && d.get('pageTo', null) == null) ||
              (d.get('pageFrom', null) != null && d.get('pageTo', null) != null && d.pageTo >= d.pageFrom)) &&
             (d.get('dueOn', null) == null || d.dueOn is timestamp) &&
             (d.get('guide', null) == null || (d.guide is list && d.guide.size() <= 5));
    }
    // A thread on a book: a title, a body, an optional page reference and chapter, whether an admin has
    // pinned or locked it, and which reply is the accepted answer.
    function validStudyThread(d) {
      return d.keys().hasOnly(['title', 'body', 'pageRef', 'chapterId', 'createdByEmail', 'createdAt', 'pinned', 'locked', 'acceptedReplyId']) &&
             d.title is string && d.title.size() >= 1 && d.title.size() <= 120 &&
             d.body is string && d.body.size() >= 1 && d.body.size() <= 2000 &&
             (d.get('pageRef', null) == null || (d.pageRef is string && d.pageRef.size() <= 20)) &&
             (d.get('chapterId', null) == null || (d.chapterId is string && d.chapterId.size() <= 40)) &&
             d.createdByEmail is string && d.createdByEmail.size() <= 254 &&
             d.createdAt is timestamp &&
             d.pinned is bool && d.locked is bool &&
             (d.get('acceptedReplyId', null) == null || (d.acceptedReplyId is string && d.acceptedReplyId.size() <= 40));
    }
    // A reply: its text, its author, when it was written, and how many members found it helpful or reported it.
    function validStudyReply(d) {
      return d.keys().hasOnly(['text', 'createdByEmail', 'createdAt', 'helpfulCount', 'reportCount']) &&
             d.text is string && d.text.size() >= 1 && d.text.size() <= 1000 &&
             d.createdByEmail is string && d.createdByEmail.size() <= 254 &&
             d.createdAt is timestamp &&
             d.helpfulCount is int && d.helpfulCount >= 0 &&
             d.reportCount is int && d.reportCount >= 0;
    }
    // A report of a reply: one of the reasons, and when it was made.
    function validStudyReport(d) {
      return d.keys().hasOnly(['reason', 'createdAt']) &&
             d.reason in ['wrong', 'unclear', 'spam', 'other'] &&
             d.createdAt is timestamp;
    }
    // Study materials. A file is stored in the group's study folder on the media server, so its address
    // must name this group and that folder, with an extension and size of its kind. A link is an http or
    // https address. A note is text written in the app.
    function studyMaterialFileOk(tourId, d) {
      let folder = 'https://bhromon\\.fun/media/' + tourId + '/study/[0-9a-f]{32}\\.';
      return d.url is string && d.sizeBytes is int && d.sizeBytes > 0 && (
        (d.kind == 'image' && d.sizeBytes <= 10485760 && d.url.matches(folder + '(jpg|jpeg|png|webp|gif|heic|heif)')) ||
        (d.kind == 'audio' && d.sizeBytes <= 26214400 && d.url.matches(folder + '(m4a|mp3|aac|wav|ogg|opus)')) ||
        (d.kind == 'video' && d.sizeBytes <= 104857600 && d.url.matches(folder + '(mp4|mov|m4v|webm|3gp|mkv)')) ||
        (d.kind == 'file' && d.sizeBytes <= 52428800 && d.url.matches(folder + '(pdf|doc|docx|xls|xlsx|ppt|pptx|txt|csv|zip)'))
      );
    }
    function studyMaterialShapeOk(tourId, d) {
      return (d.kind == 'link' && d.url is string && d.url.size() >= 8 && d.url.size() <= 2000 &&
              d.url.matches('https?://.+') && d.get('sizeBytes', null) == null && d.get('body', null) == null) ||
             (d.kind == 'note' && d.body is string && d.body.size() >= 1 && d.body.size() <= 20000 &&
              d.get('url', null) == null && d.get('sizeBytes', null) == null) ||
             (d.kind in ['file', 'image', 'audio', 'video'] && studyMaterialFileOk(tourId, d) && d.get('body', null) == null);
    }
    // A material: its title, kind, book and optional chapter, its address or text, whether it waits or is
    // published or hidden, the member's confirmation of rights, and its reports.
    function validStudyMaterial(tourId, d) {
      return d.keys().hasOnly(['title', 'kind', 'bookId', 'chapterId', 'url', 'fileName', 'sizeBytes', 'body', 'status', 'rightsConfirmed', 'reportCount', 'reportedAt', 'createdByEmail', 'createdAt', 'replacesId']) &&
             d.title is string && d.title.size() >= 1 && d.title.size() <= 120 &&
             d.kind in ['file', 'image', 'audio', 'video', 'link', 'note'] &&
             d.bookId is string && d.bookId.size() >= 1 && d.bookId.size() <= 40 &&
             (d.get('chapterId', null) == null || (d.chapterId is string && d.chapterId.size() <= 40)) &&
             (d.get('fileName', null) == null || (d.fileName is string && d.fileName.size() <= 120)) &&
             (d.get('replacesId', null) == null || (d.replacesId is string && d.replacesId.size() <= 40)) &&
             d.status in ['pending', 'published', 'hidden'] &&
             d.rightsConfirmed == true &&
             d.reportCount is int && d.reportCount >= 0 &&
             d.createdByEmail is string && d.createdByEmail.size() <= 254 &&
             d.createdAt is timestamp &&
             (d.get('reportedAt', null) == null || d.reportedAt is timestamp) &&
             studyMaterialShapeOk(tourId, d);
    }
    // A report of a material: one of the reasons, and when it was made.
    function validStudyMaterialReport(d) {
      return d.keys().hasOnly(['reason', 'createdAt']) &&
             d.reason in ['copyright', 'exam', 'personal', 'wrong', 'other'] &&
             d.createdAt is timestamp;
    }
    // Whether the group publishes materials without an admin's approval. Off unless an admin turns it on.
    function studyMaterialPublishesDirectly(tourId) {
      return get(/databases/$(database)/documents/tours/$(tourId)).data.get('studyPolicy', {}).get('materialsNeedApproval', true) == false;
    }
    // Whether an update to a material is allowed. An admin publishes a pending material or restores a hidden
    // one. The uploader or an admin edits the title. A member's report hides it at once, with its count and
    // the time of the first report. Nothing else about it changes after it is written.
    function studyMaterialUpdateAllowed(tourId, newData, oldData) {
      let changed = newData.diff(oldData).affectedKeys();
      let byAdmin = isTourAdmin(tourId);
      let byUploader = oldData.createdByEmail == tourUserEmail();
      return validStudyMaterial(tourId, newData) &&
             newData.bookId == oldData.bookId &&
             newData.kind == oldData.kind &&
             newData.createdByEmail == oldData.createdByEmail &&
             newData.createdAt == oldData.createdAt &&
             newData.get('chapterId', null) == oldData.get('chapterId', null) &&
             newData.get('url', null) == oldData.get('url', null) &&
             newData.get('body', null) == oldData.get('body', null) &&
             newData.get('sizeBytes', null) == oldData.get('sizeBytes', null) &&
             newData.get('fileName', null) == oldData.get('fileName', null) &&
             newData.get('replacesId', null) == oldData.get('replacesId', null) &&
             (
               (byAdmin && changed.hasOnly(['status']) && oldData.status == 'pending' && newData.status == 'published') ||
               (byAdmin && changed.hasOnly(['status']) && oldData.status == 'hidden' && newData.status == 'published') ||
               ((byAdmin || byUploader) && changed.hasOnly(['title'])) ||
               (!byUploader && oldData.status in ['published', 'hidden'] && changed.hasOnly(['status', 'reportCount', 'reportedAt']) &&
                newData.status == 'hidden' && newData.reportCount == oldData.reportCount + 1 &&
                ((oldData.get('reportedAt', null) == null && newData.reportedAt == request.time) ||
                 (oldData.get('reportedAt', null) != null && newData.reportedAt == oldData.reportedAt)))
             );
    }
    // Whether an update to a thread is allowed. An admin pins or locks it, or accepts an answer on
    // the asker's behalf. The member who asked accepts or un-accepts an answer, and changes nothing
    // else. An accepted answer must be a reply that exists.
    function studyThreadUpdateAllowed(tourId, bookId, threadId, newData, oldData) {
      let byAdmin = isTourAdmin(tourId);
      let changed = newData.diff(oldData).affectedKeys();
      return newData.createdByEmail == oldData.createdByEmail &&
             newData.createdAt == oldData.createdAt &&
             validStudyThread(newData) &&
             (newData.get('acceptedReplyId', null) == null ||
              exists(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(newData.acceptedReplyId))) &&
             ((byAdmin && changed.hasOnly(['pinned', 'locked', 'acceptedReplyId'])) ||
              (oldData.createdByEmail == tourUserEmail() && changed.hasOnly(['acceptedReplyId'])));
    }
    // The signed-in member's helpful mark and report on a reply: whether each is there now, and
    // whether it will be once the batch being written has been applied.
    function studyReplyMarkNow(tourId, bookId, threadId, replyId) {
      return exists(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)/helpful/$(tourUserEmail()));
    }
    function studyReplyMarkAfter(tourId, bookId, threadId, replyId) {
      return existsAfter(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)/helpful/$(tourUserEmail()));
    }
    function studyReplyReportNow(tourId, bookId, threadId, replyId) {
      return exists(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)/reports/$(tourUserEmail()));
    }
    function studyReplyReportAfter(tourId, bookId, threadId, replyId) {
      return existsAfter(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)/reports/$(tourUserEmail()));
    }
    // Whether an update to a reply is allowed. Its author edits the text. A helpful count moves by one
    // with the member's own mark, and a report count rises by one with the member's own report, both in
    // the same batch. Nothing else changes.
    function studyReplyUpdateAllowed(tourId, bookId, threadId, replyId, newData, oldData) {
      let byAdmin = isTourAdmin(tourId);
      let changed = newData.diff(oldData).affectedKeys();
      return newData.createdByEmail == oldData.createdByEmail &&
             newData.createdAt == oldData.createdAt &&
             validStudyReply(newData) &&
             ((changed.hasOnly(['helpfulCount']) &&
               ((newData.helpfulCount - oldData.helpfulCount == 1 &&
                 !studyReplyMarkNow(tourId, bookId, threadId, replyId) &&
                 studyReplyMarkAfter(tourId, bookId, threadId, replyId)) ||
                (oldData.helpfulCount - newData.helpfulCount == 1 &&
                 studyReplyMarkNow(tourId, bookId, threadId, replyId) &&
                 !studyReplyMarkAfter(tourId, bookId, threadId, replyId)))) ||
              (changed.hasOnly(['reportCount']) &&
               newData.reportCount - oldData.reportCount == 1 &&
               !studyReplyReportNow(tourId, bookId, threadId, replyId) &&
               studyReplyReportAfter(tourId, bookId, threadId, replyId)) ||
              ((byAdmin || oldData.createdByEmail == tourUserEmail()) && changed.hasOnly(['text'])));
    }

    // A reading session: what to read, when it starts, and where it meets.
    function validStudySession(d) {
      return d.keys().hasOnly(['title', 'bookId', 'chapterIds', 'startsAt', 'place', 'notes', 'createdByEmail', 'agenda', 'link', 'timerStartsAt', 'timerSeconds', 'recap', 'recapAt', 'reminder24Sent', 'reminder30Sent']) &&
             d.title is string && d.title.size() >= 1 && d.title.size() <= 120 &&
             (d.get('bookId', null) == null || (d.bookId is string && d.bookId.size() <= 100)) &&
             (d.get('chapterIds', null) == null || (d.chapterIds is list && d.chapterIds.size() <= 10)) &&
             d.startsAt is timestamp &&
             (d.get('place', null) == null || (d.place is string && d.place.size() <= 120)) &&
             (d.get('notes', null) == null || (d.notes is string && d.notes.size() <= 500)) &&
             (d.get('agenda', null) == null || (d.agenda is string && d.agenda.size() <= 500)) &&
             (d.get('link', null) == null || (d.link is string && d.link.size() <= 2000 && d.link.matches('https://.+'))) &&
             (d.get('timerStartsAt', null) == null || d.timerStartsAt is timestamp) &&
             (d.get('timerSeconds', null) == null || (d.timerSeconds is int && d.timerSeconds >= 60 && d.timerSeconds <= 14400)) &&
             (d.get('recap', null) == null || validSessionRecap(d.recap)) &&
             (d.get('recapAt', null) == null || d.recapAt is timestamp) &&
             // The reminder times are written by the media server, which bypasses these rules. They are kept
             // here so an edit by the creator does not fail once a reminder has gone out.
             (d.get('reminder24Sent', null) == null || d.reminder24Sent is timestamp) &&
             (d.get('reminder30Sent', null) == null || d.reminder30Sent is timestamp) &&
             d.createdByEmail is string && d.createdByEmail.size() <= 254;
    }
    // The reminder times belong to the media server. Nothing a member writes can change them, except that a
    // change to the start clears them, so the reminders go out again for the new time.
    function studySessionRemindersOk(newData, oldData) {
      return (newData.get('reminder24Sent', null) == oldData.get('reminder24Sent', null) &&
              newData.get('reminder30Sent', null) == oldData.get('reminder30Sent', null)) ||
             (newData.startsAt != oldData.startsAt &&
              newData.get('reminder24Sent', null) == null && newData.get('reminder30Sent', null) == null);
    }
    // The recap of a session: what was covered, what was hard, and up to ten open questions. Each question's
    // length is checked by the app, since the rules cannot check every item of a list.
    function validSessionRecap(r) {
      return r is map && r.keys().hasOnly(['covered', 'hard', 'openQuestions']) &&
             (r.get('covered', null) == null || (r.covered is string && r.covered.size() <= 1000)) &&
             (r.get('hard', null) == null || (r.hard is string && r.hard.size() <= 1000)) &&
             (r.get('openQuestions', null) == null || (r.openQuestions is list && r.openQuestions.size() <= 10));
    }
    // A member's answer to a session: going, maybe or cannot, and when they checked in, if they did.
    function validSessionRsvp(d) {
      return d.keys().hasOnly(['response', 'checkedInAt', 'updatedAt']) &&
             d.response in ['going', 'maybe', 'cannot'] &&
             (d.get('checkedInAt', null) == null || d.checkedInAt is timestamp) &&
             d.updatedAt is timestamp;
    }
    // A person without an account, listed under the member who added them.
    function validDependent(d) {
      return d.keys().hasOnly(['name', 'relation', 'parentEmail', 'countedInFamily']) &&
             d.name is string && d.name.size() >= 1 && d.name.size() <= 60 &&
             d.relation is string && d.relation.size() <= 30 &&
             d.parentEmail is string && d.parentEmail.size() <= 254 &&
             d.countedInFamily is bool;
    }
    function validFamilyDate(d) {
      return d.keys().hasOnly(['title', 'kind', 'recurrence', 'startOn', 'nextOn', 'remindDays', 'remindOn', 'note', 'createdByEmail']) &&
             d.title is string && d.title.size() >= 1 && d.title.size() <= 80 &&
             d.kind in ['birthday', 'anniversary', 'bill', 'school', 'medicine', 'meeting', 'deadline', 'exam', 'rent', 'maintenance', 'installment', 'payout', 'event', 'custom'] &&
             d.recurrence in ['once', 'monthly', 'yearly'] &&
             isDayKey(d.startOn) && isDayKey(d.nextOn) &&
             d.remindDays is int && d.remindDays >= 0 && d.remindDays <= 30 &&
             (d.get('remindOn', null) == null || isDayKey(d.remindOn)) &&
             d.get('note', '') is string && d.get('note', '').size() <= 500 &&
             d.createdByEmail is string;
    }

    // A list of member emails (likes, viewers) changes by one entry: the caller's
    // own. Either nothing changes, the caller is added, or the caller is removed.
    function ownEntryOnly(before, after) {
      return after == before ||
        (!before.hasAll([tourUserEmail()]) &&
          after.size() == before.size() + 1 &&
          after.hasAll(before) &&
          after.hasAll([tourUserEmail()])) ||
        (before.hasAll([tourUserEmail()]) &&
          after.size() == before.size() - 1 &&
          before.hasAll(after) &&
          !after.hasAll([tourUserEmail()]));
    }

    // A count (comments on a post) moves by one at a time, or not at all.
    function movesByOneAtMost(before, after) {
      return (after - before) in [-1, 0, 1];
    }

    // ---- Tours (members only) ----
    match /tours/{tourId} {
      allow get: if isAuth() &&
                    (resource.data.ownerUid == request.auth.uid || resource.data.ownerEmail == tourUserEmail() || isActiveMember(tourId));
      allow list: if false;
      allow create: if isAuth()
                    && request.resource.data.ownerEmail == tourUserEmail()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.inviteCode.size() >= 6
                    && request.resource.data.get('kind', 'tour') in ['tour', 'family'];
      // Admins edit trip details; only the owner changes ownership or the invite code.
      // The family's emergency numbers are a list of at most ten entries.
      allow update: if (isOwnerOfTour(tourId) ||
                    (isTourAdmin(tourId) &&
                     !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['ownerEmail', 'ownerUid', 'inviteCode']))) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['momentsEnabled']) || isManagedTour(tourId)) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['samity']) ||
                     (isSamityTour(tourId) && validSamityConfig(request.resource.data.samity))) &&
                    // The study policy: whether a member's material waits for an admin. Only a study group has one.
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studyPolicy']) ||
                     (isStudyTour(tourId) && request.resource.data.studyPolicy is map &&
                      request.resource.data.studyPolicy.keys().hasOnly(['materialsNeedApproval']) &&
                      request.resource.data.studyPolicy.materialsNeedApproval is bool)) &&
                    (!('emergencyContacts' in request.resource.data) ||
                     (request.resource.data.emergencyContacts is list &&
                      request.resource.data.emergencyContacts.size() <= 10)) &&
                    // The group photo is a file in this group's own media space, so members
                    // never load an outside address from the group record.
                    (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == null ||
                     (request.resource.data.photoUrl is string &&
                      request.resource.data.photoUrl.matches('https://bhromon\\.fun/media/' + tourId + '/avatars/[0-9a-f]{32}\\.(jpg|jpeg|png|webp|gif|heic|heif)')));
      allow delete: if isOwnerOfTour(tourId);

      match /private/{docId} {
        allow read, write: if isOwnerOfTour(tourId);
      }

      // Removed members. Admins write these; joining checks them.
      match /bans/{email} {
        allow read, create, delete: if isTourAdmin(tourId);
      }

      // Expenses & deposits: any member adds; only the author or an admin edits.
      match /expenses/{expenseId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == tourUserEmail() &&
                         validOptionalMfsInfo(request.resource.data, tourId) &&
                         canVerifyMfsOnCreate(request.resource.data, tourId);
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == resource.data.get('addedByEmail', '') &&
                         validOptionalMfsInfo(request.resource.data, tourId) &&
                         (
                           (resource.data.get('addedByEmail', '') == tourUserEmail() &&
                            memberMayEditMfs(resource.data, request.resource.data)) ||
                           isTourAdmin(tourId)
                         );
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      match /deposits/{depositId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == tourUserEmail() &&
                         validOptionalMfsInfo(request.resource.data, tourId) &&
                         canVerifyMfsOnCreate(request.resource.data, tourId);
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == resource.data.get('addedByEmail', '') &&
                         validOptionalMfsInfo(request.resource.data, tourId) &&
                         (
                           (resource.data.get('addedByEmail', '') == tourUserEmail() &&
                            memberMayEditMfs(resource.data, request.resource.data)) ||
                           isTourAdmin(tourId)
                         );
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      // Settle-up payments. Any member records one they took part in, or an
      // admin records any; the author or an admin deletes it.
      match /transfers/{transferId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == tourUserEmail() &&
                         request.resource.data.amountPaisa is int &&
                         request.resource.data.amountPaisa > 0 &&
                         (isTourAdmin(tourId) ||
                          request.resource.data.fromId == tourUserEmail() ||
                          request.resource.data.toId == tourUserEmail()) &&
                         validOptionalMfsInfo(request.resource.data, tourId) &&
                         canVerifyMfsOnCreate(request.resource.data, tourId);
        allow update: if false;
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      // Official notices are posted by admins. In a family circle any member
      // posts one under their own name, and its author or an admin deletes it.
      // A member answers one ("Got it", or "I'm here" in a roll call) by adding
      // or removing only their own email in ackBy. Admins may mark anyone present.
      match /notices/{noticeId} {
        allow read: if isActiveMember(tourId);
        allow create: if isTourAdmin(tourId) ||
                         (isFamilyTour(tourId) && !hasManagedNotices(tourId) && isActiveMember(tourId) &&
                          request.resource.data.authorEmail == tourUserEmail());
        allow update: if isTourAdmin(tourId);
        allow delete: if isTourAdmin(tourId) ||
                         (isFamilyTour(tourId) && !hasManagedNotices(tourId) && isActiveMember(tourId) &&
                          resource.data.get('authorEmail', '') == tourUserEmail());
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['ackBy']) &&
                         ownEntryOnly(resource.data.get('ackBy', []), request.resource.data.get('ackBy', []));
      }

      // People in a family who have no account, such as a child or a grandparent. A
      // member lists them under their own email, and only that member changes or
      // removes them.
      match /dependents/{dependentId} {
        allow read: if isActiveMember(tourId);
        allow create: if isHouseholdTour(tourId) && isActiveMember(tourId) &&
                         request.resource.data.parentEmail == tourUserEmail() &&
                         validDependent(request.resource.data);
        allow update: if isHouseholdTour(tourId) && isActiveMember(tourId) &&
                         resource.data.parentEmail == tourUserEmail() &&
                         request.resource.data.parentEmail == resource.data.parentEmail &&
                         validDependent(request.resource.data);
        allow delete: if isHouseholdTour(tourId) && isActiveMember(tourId) &&
                         resource.data.parentEmail == tourUserEmail();
      }

      // Shared shopping and to-do items. Any member of a family circle adds one under
      // their own email and ticks items off; the member who ticked it is recorded.
      // Editing and removing are for the creator or an admin.
      match /family_tasks/{taskId} {
        allow read: if isActiveMember(tourId);
        allow create: if isSharedListTour(tourId) && isActiveMember(tourId) &&
                         request.resource.data.createdByEmail == tourUserEmail() &&
                         validFamilyTask(request.resource.data);
        allow update: if isSharedListTour(tourId) && isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['done', 'doneByEmail']) &&
                         request.resource.data.createdByEmail == resource.data.createdByEmail &&
                         (request.resource.data.done
                            ? request.resource.data.get('doneByEmail', null) == tourUserEmail()
                            : request.resource.data.get('doneByEmail', null) == null) &&
                         validFamilyTask(request.resource.data);
        allow update: if isSharedListTour(tourId) && isActiveMember(tourId) &&
                         (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail()) &&
                         request.resource.data.createdByEmail == resource.data.createdByEmail &&
                         validFamilyTask(request.resource.data);
        allow delete: if isSharedListTour(tourId) && isActiveMember(tourId) &&
                         (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail());
      }

      // A study or book club's book list. A member proposes a book, and it waits for an admin,
      // who lists it or declines it. Any member moves a listed book along its statuses under
      // their own name. Its creator or an admin changes the details or removes it.
      match /study_books/{bookId} {
        allow read: if isActiveMember(tourId);
        allow create: if isStudyTour(tourId) && isActiveMember(tourId) &&
                         request.resource.data.createdByEmail == tourUserEmail() &&
                         (request.resource.data.get('statusByEmail', null) == null ||
                          request.resource.data.statusByEmail == tourUserEmail()) &&
                         ((isTourAdmin(tourId) && studyBookListed(request.resource.data)) ||
                          request.resource.data.get('approval', null) == 'proposed') &&
                         request.resource.data.get('declineNote', null) == null &&
                         validStudyBook(request.resource.data);
        allow update: if isStudyTour(tourId) && isActiveMember(tourId) &&
                         studyBookUpdateAllowed(tourId, request.resource.data, resource.data);
        allow delete: if isStudyTour(tourId) && isActiveMember(tourId) &&
                         (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail());

        // The votes for a proposed book: each member says for themselves that they would read it.
        match /votes/{voter} {
          allow read: if isActiveMember(tourId);
          allow create: if isStudyTour(tourId) && isActiveMember(tourId) && voter == tourUserEmail() &&
                           request.resource.data.keys().hasOnly(['createdAt']) &&
                           request.resource.data.createdAt == request.time &&
                           get(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)).data.get('approval', 'listed') == 'proposed';
          allow delete: if isStudyTour(tourId) && isActiveMember(tourId) && voter == tourUserEmail();
        }

        // The chapters of the book: a number, a title, its pages, a due date and up to five guide
        // questions. Only an admin sets them.
        match /chapters/{chapterId} {
          allow read: if isActiveMember(tourId);
          allow create, update: if isStudyTour(tourId) && isTourAdmin(tourId) &&
                                   validStudyChapter(request.resource.data);
          allow delete: if isStudyTour(tourId) && isTourAdmin(tourId);

          // A member's read mark on the chapter, in their own name, on a listed book. An uncounted
          // mark is private to its member; a counted one is visible to the group.
          match /reads/{voter} {
            allow read: if isActiveMember(tourId) && (voter == tourUserEmail() || resource.data.get('counted', false) == true);
            allow create: if isStudyTour(tourId) && isActiveMember(tourId) && voter == tourUserEmail() &&
                             request.resource.data.keys().hasOnly(['readAt', 'counted']) &&
                             request.resource.data.readAt == request.time &&
                             request.resource.data.counted is bool &&
                             studyBookListed(get(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)).data);
            allow update: if isStudyTour(tourId) && isActiveMember(tourId) && voter == tourUserEmail() &&
                             request.resource.data.keys().hasOnly(['readAt', 'counted']) &&
                             request.resource.data.readAt == resource.data.readAt &&
                             request.resource.data.counted is bool;
            allow delete: if isStudyTour(tourId) && isActiveMember(tourId) && voter == tourUserEmail();
          }
        }

        // Discussions on the book: a thread a member starts on a listed book. An admin pins or locks it,
        // and the member who asked accepts an answer. Its replies are below.
        match /threads/{threadId} {
          allow read: if isActiveMember(tourId);
          allow create: if isStudyTour(tourId) && isActiveMember(tourId) &&
                           request.resource.data.createdByEmail == tourUserEmail() &&
                           request.resource.data.createdAt == request.time &&
                           request.resource.data.pinned == false &&
                           request.resource.data.locked == false &&
                           request.resource.data.get('acceptedReplyId', null) == null &&
                           validStudyThread(request.resource.data) &&
                           studyBookListed(get(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)).data);
          allow update: if isStudyTour(tourId) && isActiveMember(tourId) &&
                           studyThreadUpdateAllowed(tourId, bookId, threadId, request.resource.data, resource.data);
          allow delete: if isStudyTour(tourId) && isActiveMember(tourId) &&
                           (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail());

          // The replies, flat and in time order. A member replies to an unlocked thread on a listed book.
          match /replies/{replyId} {
            allow read: if isActiveMember(tourId);
            allow create: if isStudyTour(tourId) && isActiveMember(tourId) &&
                             request.resource.data.createdByEmail == tourUserEmail() &&
                             request.resource.data.createdAt == request.time &&
                             request.resource.data.helpfulCount == 0 &&
                             request.resource.data.reportCount == 0 &&
                             validStudyReply(request.resource.data) &&
                             get(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)).data.locked == false &&
                             studyBookListed(get(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)).data);
            allow update: if isStudyTour(tourId) && isActiveMember(tourId) &&
                             studyReplyUpdateAllowed(tourId, bookId, threadId, replyId, request.resource.data, resource.data);
            allow delete: if isStudyTour(tourId) && isActiveMember(tourId) &&
                             (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail());

            // One helpful mark per member, never on their own reply. The count moves with the mark.
            match /helpful/{voter} {
              allow read: if isActiveMember(tourId);
              allow create: if isActiveMember(tourId) && voter == tourUserEmail() &&
                               request.resource.data.keys().hasOnly(['createdAt']) &&
                               request.resource.data.createdAt == request.time &&
                               get(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)).data.createdByEmail != tourUserEmail() &&
                               getAfter(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)).data.helpfulCount == get(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)).data.helpfulCount + 1;
              allow delete: if isActiveMember(tourId) && voter == tourUserEmail() &&
                               getAfter(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)).data.helpfulCount == get(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)).data.helpfulCount - 1;
            }

            // One report per member, never on their own reply. The count moves with the report. The
            // reporter and an admin read it.
            match /reports/{voter} {
              allow read: if isActiveMember(tourId) && (isTourAdmin(tourId) || voter == tourUserEmail());
              allow create: if isActiveMember(tourId) && voter == tourUserEmail() &&
                               validStudyReport(request.resource.data) &&
                               get(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)).data.createdByEmail != tourUserEmail() &&
                               getAfter(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)).data.reportCount == get(/databases/$(database)/documents/tours/$(tourId)/study_books/$(bookId)/threads/$(threadId)/replies/$(replyId)).data.reportCount + 1;
            }
          }
        }
      }

      // Study materials: a note, a file, a link or a recording a member files under a book. It waits for an
      // admin unless the group publishes directly. The uploader or an admin edits its title or removes it. A
      // report hides it at once from everyone but its uploader and the admins who decide it.
      match /study_materials/{materialId} {
        allow read: if isActiveMember(tourId);
        allow create: if isStudyTour(tourId) && isActiveMember(tourId) &&
                         request.resource.data.createdByEmail == tourUserEmail() &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.reportCount == 0 &&
                         request.resource.data.get('reportedAt', null) == null &&
                         validStudyMaterial(tourId, request.resource.data) &&
                         (request.resource.data.status == 'pending' ||
                          (request.resource.data.status == 'published' &&
                           (isTourAdmin(tourId) || studyMaterialPublishesDirectly(tourId)))) &&
                         studyBookListed(get(/databases/$(database)/documents/tours/$(tourId)/study_books/$(request.resource.data.bookId)).data);
        allow update: if isStudyTour(tourId) && isActiveMember(tourId) &&
                         studyMaterialUpdateAllowed(tourId, request.resource.data, resource.data);
        allow delete: if isStudyTour(tourId) && isActiveMember(tourId) &&
                         (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail());

        // One report per member, never on their own material. The report, the count and the hiding change in
        // one batch. The reporter and an admin read it; an admin clears reports when the material is removed.
        match /reports/{reporter} {
          allow read: if isActiveMember(tourId) && (isTourAdmin(tourId) || reporter == tourUserEmail());
          allow create: if isStudyTour(tourId) && isActiveMember(tourId) && reporter == tourUserEmail() &&
                           validStudyMaterialReport(request.resource.data) &&
                           get(/databases/$(database)/documents/tours/$(tourId)/study_materials/$(materialId)).data.createdByEmail != tourUserEmail() &&
                           get(/databases/$(database)/documents/tours/$(tourId)/study_materials/$(materialId)).data.status in ['published', 'hidden'] &&
                           getAfter(/databases/$(database)/documents/tours/$(tourId)/study_materials/$(materialId)).data.status == 'hidden' &&
                           getAfter(/databases/$(database)/documents/tours/$(tourId)/study_materials/$(materialId)).data.reportCount == get(/databases/$(database)/documents/tours/$(tourId)/study_materials/$(materialId)).data.reportCount + 1;
          allow delete: if isTourAdmin(tourId);
        }

        // A marker for each member who opened a published material. The member writes their own, once.
        match /opens/{viewer} {
          allow read: if isActiveMember(tourId) && (isTourAdmin(tourId) || viewer == tourUserEmail());
          allow create: if isStudyTour(tourId) && isActiveMember(tourId) && viewer == tourUserEmail() &&
                           request.resource.data.keys().hasOnly(['openedAt']) &&
                           request.resource.data.openedAt == request.time &&
                           get(/databases/$(database)/documents/tours/$(tourId)/study_materials/$(materialId)).data.status == 'published';
          allow delete: if isTourAdmin(tourId);
        }
      }

      // A study subject: an admin adds it, or a member proposes it for an admin to decide. Its
      // modules are turned on by an admin, and members post in the modules that are on.
      match /study_subjects/{subjectId} {
        allow read: if isActiveMember(tourId);
        allow create: if isStudyTour(tourId) && isActiveMember(tourId) &&
                         request.resource.data.createdByEmail == tourUserEmail() &&
                         ((isTourAdmin(tourId) && request.resource.data.get('approval', 'listed') == 'listed') ||
                          request.resource.data.get('approval', null) == 'proposed') &&
                         request.resource.data.get('declineNote', null) == null &&
                         validStudySubject(request.resource.data);
        allow update: if isStudyTour(tourId) && isActiveMember(tourId) &&
                         request.resource.data.createdByEmail == resource.data.createdByEmail &&
                         validStudySubject(request.resource.data) &&
                         studySubjectUpdateAllowed(tourId, request.resource.data, resource.data);

        // The modules of a subject. Only an admin turns a live module on or changes it.
        match /modules/{moduleKey} {
          allow read: if isActiveMember(tourId);
          allow create, update: if isStudyTour(tourId) && isTourAdmin(tourId) &&
                                   studyModuleLive(moduleKey) &&
                                   validStudyModule(request.resource.data);
          allow delete: if isStudyTour(tourId) && isTourAdmin(tourId);
        }

        // Tips. A member posts in a module that is on, as its post policy allows.
        match /tips/{postId} {
          allow read: if isActiveMember(tourId);
          allow create: if studyPostCreateAllowed(tourId, subjectId, 'tips', request.resource.data);
          allow update: if isStudyTour(tourId) && isActiveMember(tourId) &&
                           studyPostUpdateAllowed(tourId, subjectId, 'tips', postId, request.resource.data, resource.data);
          allow delete: if isStudyTour(tourId) && isActiveMember(tourId) &&
                           (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail());

          // One helpful mark per member: never on their own post, only on a shown one, and
          // written or removed in the same batch as the count it moves (studyPostUpdateAllowed).
          match /helpful/{voter} {
            allow read: if isActiveMember(tourId);
            allow create: if isActiveMember(tourId) && voter == tourUserEmail() &&
                             request.resource.data.keys().hasOnly(['createdAt']) &&
                             request.resource.data.createdAt == request.time &&
                             get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/tips/$(postId)).data.createdByEmail != tourUserEmail() &&
                             get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/tips/$(postId)).data.shown == true &&
                             getAfter(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/tips/$(postId)).data.helpfulCount == get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/tips/$(postId)).data.helpfulCount + 1;
            allow delete: if isActiveMember(tourId) && voter == tourUserEmail() &&
                             getAfter(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/tips/$(postId)).data.helpfulCount == get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/tips/$(postId)).data.helpfulCount - 1;
          }
        }

        // Suggestions: the same as tips.
        match /suggestions/{postId} {
          allow read: if isActiveMember(tourId);
          allow create: if studyPostCreateAllowed(tourId, subjectId, 'suggestions', request.resource.data);
          allow update: if isStudyTour(tourId) && isActiveMember(tourId) &&
                           studyPostUpdateAllowed(tourId, subjectId, 'suggestions', postId, request.resource.data, resource.data);
          allow delete: if isStudyTour(tourId) && isActiveMember(tourId) &&
                           (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail());

          match /helpful/{voter} {
            allow read: if isActiveMember(tourId);
            allow create: if isActiveMember(tourId) && voter == tourUserEmail() &&
                             request.resource.data.keys().hasOnly(['createdAt']) &&
                             request.resource.data.createdAt == request.time &&
                             get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/suggestions/$(postId)).data.createdByEmail != tourUserEmail() &&
                             get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/suggestions/$(postId)).data.shown == true &&
                             getAfter(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/suggestions/$(postId)).data.helpfulCount == get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/suggestions/$(postId)).data.helpfulCount + 1;
            allow delete: if isActiveMember(tourId) && voter == tourUserEmail() &&
                             getAfter(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/suggestions/$(postId)).data.helpfulCount == get(/databases/$(database)/documents/tours/$(tourId)/study_subjects/$(subjectId)/suggestions/$(postId)).data.helpfulCount - 1;
          }
        }
      }

      // A study or book club's reading plan. Any member plans a session; its creator or an
      // admin changes or removes it.
      match /reading_sessions/{sessionId} {
        allow read: if isActiveMember(tourId);
        allow create: if isStudyTour(tourId) && isActiveMember(tourId) &&
                         request.resource.data.createdByEmail == tourUserEmail() &&
                         request.resource.data.get('reminder24Sent', null) == null &&
                         request.resource.data.get('reminder30Sent', null) == null &&
                         validStudySession(request.resource.data);
        allow update: if isStudyTour(tourId) && isActiveMember(tourId) &&
                         (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail()) &&
                         request.resource.data.createdByEmail == resource.data.createdByEmail &&
                         studySessionRemindersOk(request.resource.data, resource.data) &&
                         validStudySession(request.resource.data);
        allow delete: if isStudyTour(tourId) && isActiveMember(tourId) &&
                         (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail());

        // Each member answers for themselves: going, maybe or cannot. A check-in is allowed once the session
        // has started, and a missed check-in counts against no one.
        match /rsvps/{voter} {
          allow read: if isActiveMember(tourId);
          allow create, update: if isStudyTour(tourId) && isActiveMember(tourId) && voter == tourUserEmail() &&
                                   validSessionRsvp(request.resource.data) &&
                                   request.resource.data.updatedAt == request.time &&
                                   (request.resource.data.get('checkedInAt', null) == null ||
                                    get(/databases/$(database)/documents/tours/$(tourId)/reading_sessions/$(sessionId)).data.startsAt <= request.time);
          allow delete: if isActiveMember(tourId) && voter == tourUserEmail();
        }
      }

      // Important / family dates. Any member of a tour group adds one under their own email.
      // Its creator or an admin changes or removes it. The daily reminder job moves
      // nextOn and remindOn on with admin rights, so they can change under the rules.
      match /family_dates/{dateId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.createdByEmail == tourUserEmail() &&
                         validFamilyDate(request.resource.data);
        allow update: if isActiveMember(tourId) &&
                         (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail()) &&
                         request.resource.data.createdByEmail == resource.data.createdByEmail &&
                         validFamilyDate(request.resource.data);
        allow delete: if isActiveMember(tourId) &&
                         (isTourAdmin(tourId) || resource.data.get('createdByEmail', '') == tourUserEmail());
      }

      // Mess meal counts: each member logs their own breakfast, lunch and dinner for a
      // day, and an owner or admin may log for anyone. Only a mess keeps them, and each
      // count is a whole number from 0 to 5.
      match /meals/{mealId} {
        function validMeal(d) {
          return d.keys().hasOnly(['dateKey', 'email', 'breakfast', 'lunch', 'dinner', 'updatedByEmail', 'updatedAt']) &&
                 d.dateKey is string && d.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
                 d.email is string && d.email.size() > 0 &&
                 mealId == d.dateKey + '__' + d.email &&
                 d.breakfast is int && d.breakfast >= 0 && d.breakfast <= 5 &&
                 d.lunch is int && d.lunch >= 0 && d.lunch <= 5 &&
                 d.dinner is int && d.dinner >= 0 && d.dinner <= 5 &&
                 d.updatedByEmail == tourUserEmail();
        }
        allow read: if isActiveMember(tourId);
        allow create, update: if isMessTour(tourId) && isActiveMember(tourId) &&
                                 (request.resource.data.email == tourUserEmail() || isTourAdmin(tourId)) &&
                                 validMeal(request.resource.data);
        allow delete: if isMessTour(tourId) && isActiveMember(tourId) &&
                         (resource.data.email == tourUserEmail() || isTourAdmin(tourId));
      }

      // Mess bazar duty schedule: admins assign members to daily market duties.
      // Assigned members can update status and notes; only admins can reassign or delete.
      match /mess_bazar_schedule/{dateKey} {
        function validBazarSchedule(d) {
          return d.keys().hasOnly(['dateKey', 'assignedEmails', 'assignedNames', 'note', 'estimatedBudgetPaisa', 'isCompleted', 'actualExpensePaisa', 'expenseId', 'updatedByEmail', 'updatedAt']) &&
                 d.dateKey == dateKey &&
                 d.assignedEmails is list && d.assignedEmails.size() <= 20 &&
                 (!('assignedNames' in d) || d.assignedNames is list) &&
                 (!('note' in d) || (d.note is string && d.note.size() <= 500)) &&
                 (!('estimatedBudgetPaisa' in d) || (d.estimatedBudgetPaisa is int && d.estimatedBudgetPaisa >= 0)) &&
                 (!('actualExpensePaisa' in d) || (d.actualExpensePaisa is int && d.actualExpensePaisa >= 0)) &&
                 (!('expenseId' in d) || d.expenseId is string) &&
                 d.isCompleted is bool &&
                 d.updatedByEmail == tourUserEmail();
        }

        allow read: if isMessTour(tourId) && isActiveMember(tourId);
        allow create: if isMessTour(tourId) && isActiveMember(tourId) && isTourAdmin(tourId) &&
                         validBazarSchedule(request.resource.data);
        allow update: if isMessTour(tourId) && isActiveMember(tourId) && validBazarSchedule(request.resource.data) &&
                         (isTourAdmin(tourId) ||
                          (resource.data.assignedEmails.hasAny([tourUserEmail()]) &&
                           request.resource.data.assignedEmails == resource.data.assignedEmails &&
                           request.resource.data.dateKey == resource.data.dateKey));
        allow delete: if isMessTour(tourId) && isActiveMember(tourId) && isTourAdmin(tourId);
      }

      // Service requests in a housing society. Any member raises one under their own email, and
      // it starts open. While it is open its author may correct the words. The owner or an
      // admin moves it on and leaves a note for the residents, and the author or an admin
      // removes it.
      match /service_requests/{requestId} {
        // A photo is an upload from this tour's own media space.
        function validPhoto(p) {
          return p is string &&
                 p.matches('https://bhromon\\.fun/media/' + tourId + '/media/[0-9a-f]{32}\\.(jpg|jpeg|png|webp|gif|heic|heif)');
        }

        function validRequest(d) {
          return d.keys().hasOnly(['title', 'details', 'category', 'status', 'adminNote', 'createdByEmail', 'createdByName', 'createdAt', 'updatedAt', 'updatedByEmail', 'photoUrls', 'photoUrl', 'inProgressAt', 'resolvedAt', 'resolvedByName']) &&
                 d.title is string && d.title.size() >= 3 && d.title.size() <= 120 &&
                 d.details is string && d.details.size() <= 1000 &&
                 d.category in ['lift', 'water', 'power', 'security', 'cleaning', 'other'] &&
                 d.status in ['open', 'in_progress', 'resolved'] &&
                 d.adminNote is string && d.adminNote.size() <= 500 &&
                 d.createdByEmail is string &&
                 d.createdByName is string && d.createdByName.size() <= 200 &&
                 d.updatedByEmail == tourUserEmail() &&
                 // Up to three photos, each from this tour's own media space. A request raised
                 // with the older single photoUrl stays valid until its author edits it.
                 (!('photoUrl' in d) || d.photoUrl == null || validPhoto(d.photoUrl)) &&
                 (!('photoUrls' in d) || d.photoUrls == null ||
                  (d.photoUrls is list && d.photoUrls.size() <= 3 &&
                   (d.photoUrls.size() < 1 || validPhoto(d.photoUrls[0])) &&
                   (d.photoUrls.size() < 2 || validPhoto(d.photoUrls[1])) &&
                   (d.photoUrls.size() < 3 || validPhoto(d.photoUrls[2])))) &&
                 // The timeline stamps that the committee's status save writes, and who resolved
                 // the request. Only an owner or admin can write these (see the admin rule below).
                 (!('inProgressAt' in d) || d.inProgressAt is timestamp) &&
                 (!('resolvedAt' in d) || d.resolvedAt is timestamp) &&
                 (!('resolvedByName' in d) || (d.resolvedByName is string && d.resolvedByName.size() <= 200));
        }
        allow read: if isActiveMember(tourId);
        allow create: if isSocietyTour(tourId) && isActiveMember(tourId) &&
                         request.resource.data.createdByEmail == tourUserEmail() &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.status == 'open' &&
                         request.resource.data.adminNote == '' &&
                         !request.resource.data.keys().hasAny(['inProgressAt', 'resolvedAt', 'resolvedByName']) &&
                         validRequest(request.resource.data);
        allow update: if isSocietyTour(tourId) && isActiveMember(tourId) &&
                         resource.data.createdByEmail == tourUserEmail() &&
                         resource.data.status == 'open' &&
                         request.resource.data.status == 'open' &&
                         request.resource.data.adminNote == resource.data.adminNote &&
                         request.resource.data.createdByEmail == resource.data.createdByEmail &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.updatedAt == request.time &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['title', 'details', 'category', 'photoUrls', 'photoUrl', 'updatedAt', 'updatedByEmail']) &&
                         validRequest(request.resource.data);
        allow update: if isSocietyTour(tourId) && isActiveMember(tourId) && isTourAdmin(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'adminNote', 'updatedAt', 'updatedByEmail', 'inProgressAt', 'resolvedAt', 'resolvedByName']) &&
                         request.resource.data.updatedAt == request.time &&
                         validRequest(request.resource.data);
        allow delete: if isSocietyTour(tourId) && isActiveMember(tourId) &&
                         (resource.data.createdByEmail == tourUserEmail() || isTourAdmin(tourId));
      }

      // Journey events (roadmap LJ-4.1). A member's arrival at, or departure from, a stop of
      // the trip, written only while that member shares their location. Events carry no
      // coordinates. The document id is the stop, the member and the type, so a retry cannot
      // duplicate an event. Any member reads them. The author or an admin deletes one.
      match /journey_events/{eventId} {
        function validEvent(d) {
          return d.keys().hasOnly(['type', 'stopId', 'email', 'uid', 'createdAt']) &&
                 d.type in ['arrive', 'depart'] &&
                 d.stopId is string && d.stopId.size() > 0 && d.stopId.size() <= 80 &&
                 d.email == tourUserEmail() &&
                 d.uid == request.auth.uid &&
                 d.createdAt == request.time &&
                 eventId == d.stopId + '__' + d.email + '__' + d.type;
        }
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) && validEvent(request.resource.data);
        allow update: if false;
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.email == tourUserEmail() || isTourAdmin(tourId));
      }

      // Samity payments. Each member records what they have paid into a cycle, and an owner or
      // admin records any member's. The amount is what has been paid so far for the cycle, and
      // may not exceed the contribution. The member or an admin removes a record.
      match /samity_payments/{paymentId} {
        function validPayment(d, tId) {
          return d.keys().hasOnly(['cycleKey', 'email', 'amountTaka', 'recordedByEmail', 'updatedAt', 'mfsInfo']) &&
                 d.cycleKey is string && d.cycleKey.matches('^[0-9]{3}$') &&
                 d.email is string && d.email.size() > 0 &&
                 paymentId == d.cycleKey + '__' + d.email &&
                 d.amountTaka is int && d.amountTaka >= 1 &&
                 d.amountTaka <= get(/databases/$(database)/documents/tours/$(tId)).data.samity.contributionTaka &&
                 d.recordedByEmail == tourUserEmail() &&
                 d.updatedAt == request.time &&
                 validOptionalMfsInfo(d, tId);
        }
        allow read: if isActiveMember(tourId);
        allow create: if isSamityTour(tourId) && isActiveMember(tourId) &&
                                 (request.resource.data.email == tourUserEmail() || isTourAdmin(tourId)) &&
                                 validPayment(request.resource.data, tourId) &&
                                 canVerifyMfsOnCreate(request.resource.data, tourId);
        allow update: if isSamityTour(tourId) && isActiveMember(tourId) &&
                                 validPayment(request.resource.data, tourId) &&
                                 (
                                   (request.resource.data.email == tourUserEmail() &&
                                    memberMayEditMfs(resource.data, request.resource.data)) ||
                                   isTourAdmin(tourId)
                                 );
        allow delete: if isSamityTour(tourId) && isActiveMember(tourId) &&
                         (resource.data.email == tourUserEmail() || isTourAdmin(tourId));
      }

      // Atomic Per-Group MFS TrxID Uniqueness Registry
      // Document ID is the normalized uppercase TrxID (e.g., `BKL890XYZ1`).
      // Creating a document here inside a writeBatch/transaction with an expense or
      // settlement guarantees zero duplicate TrxIDs within the same tourId.
      match /mfs_trx_registry/{trxId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
          trxId.matches('^[A-Z0-9]{8,14}$') &&
          request.resource.data.keys().hasOnly([
            'trxId',
            'provider',
            'recordType',
            'recordId',
            'amountPaisa',
            'addedByEmail',
            'createdAt'
          ]) &&
          request.resource.data.trxId == trxId &&
          request.resource.data.addedByEmail == tourUserEmail() &&
          validMfsProvider(request.resource.data.provider) &&
          request.resource.data.amountPaisa is int &&
          request.resource.data.amountPaisa > 0;
        allow update: if false;
        allow delete: if isActiveMember(tourId) && (
          resource.data.get('addedByEmail', '') == tourUserEmail() ||
          isTourAdmin(tourId)
        );
      }

      // `/settlements/{settlementId}`: structured MFS settle-up records
      // Stores `SettlementRecord.toMap()` documents with full MfsPaymentInfo support.
      match /settlements/{settlementId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
          request.resource.data.tourId == tourId &&
          request.resource.data.addedByEmail == tourUserEmail() &&
          request.resource.data.amountPaisa is int &&
          request.resource.data.amountPaisa > 0 &&
          (
            isTourAdmin(tourId) ||
            request.resource.data.fromMemberId == tourUserEmail() ||
            request.resource.data.toMemberId == tourUserEmail()
          ) &&
          validMfsInfo(request.resource.data.mfsInfo, tourId) &&
          canVerifyMfsOnCreate(request.resource.data, tourId);
        allow update: if isActiveMember(tourId) &&
          request.resource.data.tourId == resource.data.tourId &&
          request.resource.data.addedByEmail == resource.data.addedByEmail &&
          request.resource.data.amountPaisa == resource.data.amountPaisa &&
          request.resource.data.fromMemberId == resource.data.fromMemberId &&
          request.resource.data.toMemberId == resource.data.toMemberId &&
          validMfsInfo(request.resource.data.mfsInfo, tourId) &&
          (
            // Tour admin can verify/dispute any settlement
            isTourAdmin(tourId) ||
            // Original creator can edit notes or unverified MFS details before verification
            (
              resource.data.addedByEmail == tourUserEmail() &&
              resource.data.mfsInfo.get('status', 'unverified') == 'unverified' &&
              request.resource.data.mfsInfo.get('status', 'unverified') == 'unverified'
            )
          );
        allow delete: if isActiveMember(tourId) &&
          (
            isTourAdmin(tourId) ||
            (
              resource.data.addedByEmail == tourUserEmail() &&
              resource.data.mfsInfo.get('status', 'unverified') != 'verified'
            )
          );
      }

      // Samity payouts: the pot for a cycle, handed to its recipient. Only an owner or admin
      // records a handover, once per cycle, under the cycle's three-digit key. Beneficiary recipient
      // or an admin can verify receipt.
      match /samity_payouts/{cycleKey} {
        function validPayout(d) {
          return d.keys().hasOnly(['cycleKey', 'recipientEmail', 'amountTaka', 'recordedByEmail', 'updatedAt', 'receiptUrl', 'isVerified', 'verifiedAt']) &&
                 d.cycleKey is string && d.cycleKey.matches('^[0-9]{3}$') && d.cycleKey == cycleKey &&
                 d.recipientEmail is string && d.recipientEmail.size() > 0 &&
                 d.amountTaka is int && d.amountTaka >= 1 &&
                 (d.recordedByEmail == tourUserEmail() || (resource != null && d.recordedByEmail == resource.data.recordedByEmail)) &&
                 (d.updatedAt == request.time || (resource != null && d.updatedAt == resource.data.updatedAt)) &&
                 (!('receiptUrl' in d) || d.receiptUrl == null || (d.receiptUrl is string && d.receiptUrl.size() <= 2048 && (d.receiptUrl == '' || d.receiptUrl.matches('^https://.*')))) &&
                 (!('isVerified' in d) || d.isVerified == null || d.isVerified is bool) &&
                 (!('verifiedAt' in d) || d.verifiedAt == null || d.verifiedAt is timestamp);
        }
        allow read: if isActiveMember(tourId);
        allow create: if isSamityTour(tourId) && isTourAdmin(tourId) && validPayout(request.resource.data);
        allow update: if isSamityTour(tourId) && isActiveMember(tourId) && validPayout(request.resource.data) &&
                         (
                           isTourAdmin(tourId) ||
                           (
                             resource.data.recipientEmail == tourUserEmail() &&
                             request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['isVerified', 'verifiedAt', 'updatedAt'])
                           )
                         );
        allow delete: if isSamityTour(tourId) && isTourAdmin(tourId);
      }

      // Packing checklist: members tick items; admins remove them.
      match /checklist/{itemId} {
        allow read, create, update: if isActiveMember(tourId);
        allow delete: if isTourAdmin(tourId);
      }

      match /itinerary/{itemId} {
        allow read: if isActiveMember(tourId);
        allow write: if isTourAdmin(tourId);
      }

      // Legacy collection kept for reads only.
      match /members/{memberId} {
        allow read: if isActiveMember(tourId);
        allow write: if false;
      }

      match /posts/{postId} {
        allow read: if isActiveMember(tourId);
        // The server stamps the time. A new post starts with no likes or comments.
        allow create: if isActiveMember(tourId) && momentsOpen(tourId) &&
                         request.resource.data.authorEmail == tourUserEmail() &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.get('likes', []).size() == 0 &&
                         request.resource.data.get('commentCount', 0) == 0 &&
                         request.resource.data.get('images', []).size() <= 10 &&
                         request.resource.data.get('caption', '').size() <= 2200;

        // Any member likes or unlikes the post (their own entry only). Adding or
        // removing a comment moves the count by one.
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['likes', 'commentCount']) &&
                         ownEntryOnly(resource.data.get('likes', []), request.resource.data.get('likes', [])) &&
                         movesByOneAtMost(resource.data.get('commentCount', 0), request.resource.data.get('commentCount', 0));

        // Any member records their own view (their own email added to viewers, viewCount moved by at most one).
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['viewers', 'viewCount']) &&
                         ownEntryOnly(resource.data.get('viewers', []), request.resource.data.get('viewers', [])) &&
                         movesByOneAtMost(resource.data.get('viewCount', 0), request.resource.data.get('viewCount', 0));

        // The author or an admin edits the post's text, tags and settings.
        allow update: if isActiveMember(tourId) &&
                         (resource.data.get('authorEmail', '') == tourUserEmail() || isTourAdmin(tourId)) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['caption', 'location', 'tourDay', 'tags', 'isEdited', 'editedAt',
                                     'isArchived', 'isPinned', 'hideLikeCount', 'disableComments']) &&
                         request.resource.data.get('caption', '').size() <= 2200;

        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('authorEmail', '') == tourUserEmail() || isTourAdmin(tourId));

        match /comments/{commentId} {
          allow read: if isActiveMember(tourId);
          allow create: if isActiveMember(tourId) &&
                           request.resource.data.authorEmail == tourUserEmail() &&
                           request.resource.data.createdAt == request.time &&
                           request.resource.data.get('text', '').size() <= 500 &&
                           get(/databases/$(database)/documents/tours/$(tourId)/posts/$(postId)).data.get('disableComments', false) != true;

          // Any member likes or unlikes a comment (their own entry only).
          allow update: if isActiveMember(tourId) &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['likes']) &&
                           ownEntryOnly(resource.data.get('likes', []), request.resource.data.get('likes', []));

          // The post's author or an admin pins a comment or marks the author's like.
          allow update: if isActiveMember(tourId) &&
                           (get(/databases/$(database)/documents/tours/$(tourId)/posts/$(postId)).data.get('authorEmail', '') == tourUserEmail() || isTourAdmin(tourId)) &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['isPinned', 'isAuthorLiked']);

          // The comment's author, the post's author, or an admin may delete it.
          allow delete: if isActiveMember(tourId) &&
                           (resource.data.get('authorEmail', '') == tourUserEmail() ||
                            get(/databases/$(database)/documents/tours/$(tourId)/posts/$(postId)).data.get('authorEmail', '') == tourUserEmail() ||
                            isTourAdmin(tourId));
        }
      }

      match /stories/{storyId} {
        allow read: if isActiveMember(tourId);
        // A caption, the media links and a poll have size limits. A field that is
        // not set counts as absent.
        allow create: if isActiveMember(tourId) && momentsOpen(tourId) &&
                         request.resource.data.authorEmail == tourUserEmail() &&
                         request.resource.data.createdAt == request.time &&
                         (request.resource.data.get('caption', null) == null || request.resource.data.caption.size() <= 2200) &&
                         (request.resource.data.get('mediaUrl', null) == null || request.resource.data.mediaUrl.size() <= 2048) &&
                         (request.resource.data.get('videoUrl', null) == null || request.resource.data.videoUrl.size() <= 2048) &&
                         (request.resource.data.get('poll', null) == null || request.resource.data.poll.options.size() <= 4);

        // A member records their own view.
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['viewers']) &&
                         ownEntryOnly(resource.data.get('viewers', []), request.resource.data.get('viewers', []));

        // A member votes once in a poll, for an option that exists.
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['poll']) &&
                         request.resource.data.poll.diff(resource.data.poll).affectedKeys()
                           .hasOnly(['votes']) &&
                         request.resource.data.poll.votes.diff(resource.data.poll.get('votes', {})).affectedKeys()
                           .hasOnly([tourUserEmail()]) &&
                         !(tourUserEmail() in resource.data.poll.get('votes', {})) &&
                         request.resource.data.poll.votes.get(tourUserEmail(), -1) >= 0 &&
                         request.resource.data.poll.votes.get(tourUserEmail(), -1) < resource.data.poll.options.size();

        // A member sets or clears their own reaction.
        allow update: if isActiveMember(tourId) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['reactions']) &&
                         request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys()
                           .hasOnly([tourUserEmail()]) &&
                         request.resource.data.reactions.get(tourUserEmail(), '').size() <= 16;

        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('authorEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      // Highlights are kept by the member who made them, and by admins.
      match /highlights/{highlightId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.createdByEmail == tourUserEmail();
        allow update, delete: if isActiveMember(tourId) &&
                                 (resource.data.get('createdByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      // Discussion channels. The four built-in channels need no document; admins
      // add more, change a channel's topic, and can limit posting to admins.
      match /channels/{channelId} {
        allow read: if isActiveMember(tourId);
        allow create, update: if isTourAdmin(tourId) &&
                                 request.resource.data.name is string &&
                                 request.resource.data.name.size() <= 40 &&
                                 request.resource.data.topic is string &&
                                 request.resource.data.topic.size() <= 200 &&
                                 request.resource.data.adminOnly is bool;
        allow delete: if isTourAdmin(tourId);

        // Typing signal: each member writes only their own entry.
        match /typing/{typingEmail} {
          allow read: if isActiveMember(tourId);
          allow write: if isActiveMember(tourId) && typingEmail == tourUserEmail();
        }

        // Voice room seats. A member writes only their own seat. The heartbeat
        // (lastSeenAt) is stamped by the server, so a seat whose app died stops
        // looking live once it goes stale.
        match /voice_participants/{participantEmail} {
          function isOwnSeat() {
            return isActiveMember(tourId) && participantEmail == tourUserEmail();
          }
          allow read: if isActiveMember(tourId);
          allow create, update: if isOwnSeat()
            && request.resource.data.email == participantEmail
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.keys().hasOnly([
              'email', 'displayName', 'photoUrl', 'uid', 'isAudioMuted',
              'isVideoOn', 'joinedAt', 'lastSeenAt', 'sessionId'
            ])
            && request.resource.data.lastSeenAt == request.time
            && maxLength('displayName', 80)
            && maxLength('photoUrl', 512);
          allow delete: if isOwnSeat();
        }

        // Voice signaling for one pair. The id is the two sorted emails joined by
        // "__", and only those two members can read or write it. Offers, answers
        // and candidates carry network addresses, so other members cannot see them.
        match /voice_signals/{pairId} {
          function isPairMember() {
            return isActiveMember(tourId)
              && pairId.split('__').size() == 2
              && tourUserEmail() in pairId.split('__');
          }
          allow read, write: if isPairMember();
          match /{candCollection}/{candId} {
            allow read, write: if isPairMember();
          }
        }

        match /messages/{messageId} {
          allow read: if isActiveMember(tourId);

          // Post as yourself, with no message text length limit and within photo
          // limits. In an admin-only channel, only admins post.
          allow create: if isActiveMember(tourId) &&
                           request.resource.data.senderEmail == tourUserEmail() &&
                           request.resource.data.kind in ['text', 'poll', 'expense'] &&
                           request.resource.data.text is string &&
                           request.resource.data.get('attachments', []).size() <= 4 &&
                           (isTourAdmin(tourId) ||
                            !(exists(/databases/$(database)/documents/tours/$(tourId)/channels/$(channelId)) &&
                              get(/databases/$(database)/documents/tours/$(tourId)/channels/$(channelId)).data.get('adminOnly', false) == true));

          // The author edits the text and its mentions only.
          allow update: if isActiveMember(tourId) &&
                           resource.data.get('senderEmail', '') == tourUserEmail() &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['text', 'mentions', 'editedAt']) &&
                           request.resource.data.text is string;

          // Admins pin and unpin, and change nothing else.
          allow update: if isTourAdmin(tourId) &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['isPinned', 'pinnedByEmail']);

          // Any member sets or clears their own reaction. Other entries must not change.
          allow update: if isActiveMember(tourId) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
                           request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys()
                             .hasOnly([tourUserEmail()]) &&
                           request.resource.data.reactions.get(tourUserEmail(), '').size() <= 16;

          // Any member votes in a poll, once per poll. Only their own vote changes.
          allow update: if isActiveMember(tourId) &&
                           resource.data.get('pollOptions', []).size() > 0 &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
                           request.resource.data.votes.diff(resource.data.get('votes', {})).affectedKeys()
                             .hasOnly([tourUserEmail()]) &&
                           request.resource.data.votes.get(tourUserEmail(), 0) >= 0 &&
                           request.resource.data.votes.get(tourUserEmail(), 0) < resource.data.get('pollOptions', []).size();

          allow delete: if isActiveMember(tourId) &&
                           (resource.data.get('senderEmail', '') == tourUserEmail() || isTourAdmin(tourId));
        }
      }

      // Live family locations: members read them; each person writes their own.
      match /locations/{locId} {
        allow read: if isActiveMember(tourId);
        allow write: if isActiveMember(tourId) &&
                        request.resource.data.get('email', '') == tourUserEmail();
      }

      match /profiles/{profId} {
        allow read: if isActiveMember(tourId);
        allow write: if isActiveMember(tourId) &&
                        request.resource.data.get('uid', '') == request.auth.uid;
      }

      match /meta/{metaId} {
        allow read: if isActiveMember(tourId);
        allow write: if isTourAdmin(tourId);
      }

      // Shared route stops added on the highway roadmap.
      match /checkpoints/{checkpointId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) &&
                         request.resource.data.addedByEmail == tourUserEmail();
        // The author or an admin edits a stop or marks it passed; the author
        // stays the same.
        allow update: if isActiveMember(tourId) &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId)) &&
                         request.resource.data.get('addedByEmail', '') == resource.data.get('addedByEmail', '');
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.get('addedByEmail', '') == tourUserEmail() || isTourAdmin(tourId));
      }

      // Safety alerts (SOS). A member raises one for themselves, stamped with the
      // server time. The sender or an admin resolves it, and resolving may change
      // only the resolution fields.
      // ---- Presence: who is in the group right now ----
      // One document per member, keyed by their own email, refreshed while they
      // have the channels open. Members see each other; only the member writes
      // their own entry.
      // Battery and place sharing for the family. A member writes only their own
      // record, and every field is checked, so nobody can publish for someone else.
      // The place is present only while the member is sharing it. Members read the
      // records to see how the family is doing.
      match /telemetry/{email} {
        function telemetryFields() {
          return ['email', 'name', 'batteryLevel', 'isCharging', 'sharing',
                  'latitude', 'longitude', 'updatedAt', 'safeAt'];
        }
        function isOwnTelemetry() {
          return email == tourUserEmail() && request.resource.data.email == email;
        }
        allow read: if isActiveMember(tourId);
        allow create, update: if isActiveMember(tourId) && isOwnTelemetry() &&
          request.resource.data.keys().hasOnly(telemetryFields()) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() <= 80 &&
          (request.resource.data.batteryLevel == null ||
            (request.resource.data.batteryLevel is int &&
             request.resource.data.batteryLevel >= 0 &&
             request.resource.data.batteryLevel <= 100)) &&
          (request.resource.data.isCharging == null ||
            request.resource.data.isCharging is bool) &&
          request.resource.data.sharing is bool &&
          (request.resource.data.latitude == null ||
            (request.resource.data.latitude is number &&
             request.resource.data.latitude >= -90 &&
             request.resource.data.latitude <= 90)) &&
          (request.resource.data.longitude == null ||
            (request.resource.data.longitude is number &&
             request.resource.data.longitude >= -180 &&
             request.resource.data.longitude <= 180)) &&
          (request.resource.data.sharing == true ||
            (request.resource.data.latitude == null &&
             request.resource.data.longitude == null)) &&
          request.resource.data.updatedAt == request.time &&
          (!('safeAt' in request.resource.data) ||
            request.resource.data.safeAt == null ||
            request.resource.data.safeAt is timestamp);
        // A delete has no incoming data, so only the path's email is checked.
        allow delete: if isActiveMember(tourId) && email == tourUserEmail();
      }

      match /presence/{email} {
        allow read: if isActiveMember(tourId);
        allow create, update: if isActiveMember(tourId)
                              && email == tourUserEmail()
                              && request.resource.data.keys().hasOnly(['email', 'displayName', 'lastSeen'])
                              && request.resource.data.email == tourUserEmail()
                              && request.resource.data.displayName is string
                              && request.resource.data.displayName.size() <= 80
                              && request.resource.data.lastSeen == request.time;
        allow delete: if isActiveMember(tourId) && email == tourUserEmail();
      }

      match /sos/{alertId} {
        allow read: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) && !isManagedTour(tourId) &&
                         request.resource.data.senderEmail == tourUserEmail() &&
                         request.resource.data.resolved == false &&
                         request.resource.data.createdAt == request.time;
        allow update: if isActiveMember(tourId) &&
                         (resource.data.senderEmail == tourUserEmail() || isTourAdmin(tourId)) &&
                         request.resource.data.senderEmail == resource.data.senderEmail &&
                         request.resource.data.resolved == true &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['resolved', 'resolvedByEmail', 'resolvedAt']);
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.senderEmail == tourUserEmail() || isTourAdmin(tourId));
      }

      match /bus_seats/{seatId} {
        allow read, write: if isActiveMember(tourId);
      }

      // Buses, trains, flights, launches and the like. Admins set them up.
      match /vehicles/{vehicleId} {
        allow read: if isActiveMember(tourId);
        allow create, update: if isTourAdmin(tourId) &&
                                 request.resource.data.id == vehicleId &&
                                 request.resource.data.rows is int &&
                                 request.resource.data.rows >= 1 &&
                                 request.resource.data.rows <= 40;
        allow delete: if isTourAdmin(tourId);
      }

      // One document per seat, named "<vehicleId>__<seatNumber>". Members
      // change seats unless an admin has locked the vehicle.
      match /vehicle_seats/{seatId} {
        function vehicleLocked(vId) {
          return get(/databases/$(database)/documents/tours/$(tourId)/vehicles/$(vId)).data.get('locked', false) == true;
        }
        allow read: if isActiveMember(tourId);
        allow create, update: if isActiveMember(tourId) &&
                                 seatId == request.resource.data.vehicleId + '__' + request.resource.data.seatNumber &&
                                 exists(/databases/$(database)/documents/tours/$(tourId)/vehicles/$(request.resource.data.vehicleId)) &&
                                 (isTourAdmin(tourId) || !vehicleLocked(request.resource.data.vehicleId)) &&
                                 request.resource.data.keys().hasOnly([
                                   'seatNumber', 'vehicleId', 'assignedMemberEmail',
                                   'assignedMemberName', 'isWindow', 'familySlot']);
        allow delete: if isActiveMember(tourId) &&
                         (isTourAdmin(tourId) || !vehicleLocked(resource.data.vehicleId));
      }

      // Rooms are created and removed by admins; members update guest lists.
      match /hotel_rooms/{roomId} {
        allow read: if isActiveMember(tourId);
        allow create, delete: if isTourAdmin(tourId);
        allow update: if isActiveMember(tourId);
      }

      // Luggage and cargo items tracked for the tour group.
      match /luggage/{luggageId} {
        allow read: if isActiveMember(tourId);
        allow create, update: if isActiveMember(tourId);
        allow delete: if isActiveMember(tourId) &&
                         (resource.data.ownerEmail == tourUserEmail() || isTourAdmin(tourId));
      }

      // Online Game Zone tables for tour group members. Other games keep their
      // rules. The 29, Teen Patti and carrom tables are run by the server
      // (card29Start, card29Act, ..., teenPattiStart, teenPattiAct, ...,
      // carromStart, carromShoot, ...), so members may only create a waiting
      // table, join or leave one before it starts, and delete one that is not
      // in play.
      function serverRunTable(data) {
        return data.get('gameType', '') in ['card29', 'teen_patti', 'carrom'];
      }

      match /games/{gameId} {
        allow read, list: if isActiveMember(tourId);
        allow create: if isActiveMember(tourId) && (
          !serverRunTable(request.resource.data) ||
          (request.resource.data.status == 'waiting' &&
           request.resource.data.hostEmail == tourUserEmail() &&
           request.resource.data.get('state', {}).size() == 0));
        allow update: if isActiveMember(tourId) && (
          !serverRunTable(resource.data) ||
          (resource.data.status == 'waiting' &&
           request.resource.data.status == 'waiting' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'hostEmail', 'updatedAt'])));
        allow delete: if isActiveMember(tourId) && (
          !serverRunTable(resource.data) ||
          resource.data.status != 'inProgress' ||
          resource.data.hostEmail == tourUserEmail());

        // Each seat's private cards. Only the seat's owner may read them, and the
        // server writes them.
        match /private/{seatId} {
          allow read: if isActiveMember(tourId) && resource.data.owner == tourUserEmail();
          allow write: if false;
        }
      }
    }

    // ---- Invite codes: looked up by exact code only (no listing) ----
    // Codes are 8 characters. The six-character codes from before are retired, and their
    // tours get new codes (functions/scripts/upgradeLegacyInviteCodes.js). A six-character
    // code is about a billion guesses, which is too few to leave open to lookup.
    match /invites/{code} {
      allow get: if isAuth() && code.size() == 8;
      allow create: if isAuth() && code.size() == 8 && isOwnerOfTour(request.resource.data.tourId) &&
                       request.resource.data.code == code;
      allow update, delete: if isAuth() && isOwnerOfTour(resource.data.tourId);
    }

    // ---- Official instafeed ----
    // Posts the Bhromon team publishes for everyone signed in. The server writes them
    // (media-server publish_official_post); no app writes them, and nothing records who read them.
    match /official_instafeed/{postId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ---- Memberships ----
    // Each person can read their own rows; members see the roster of their tour.
    match /memberships/{membershipId} {
      // A row's uid is written only by the person it belongs to. Chats and calls
      // trust the uid, so nobody can claim someone else's.
      function uidIsOwners(data) {
        return !('uid' in data) || (data.email == tourUserEmail() && data.uid == request.auth.uid);
      }

      allow get: if isAuth() &&
                    (resource == null || resource.data.uid == request.auth.uid || resource.data.email == tourUserEmail() || isActiveMember(resource.data.tourId));
      allow list: if isAuth() &&
                     (resource.data.uid == request.auth.uid || resource.data.email == tourUserEmail() || isActiveMember(resource.data.tourId));
      // Owners are created with the tour; members join with a valid invite code,
      // or are added directly by an owner or admin.
      allow create: if isAuth() &&
                       membershipId == request.resource.data.tourId + '__' + request.resource.data.email &&
                       request.resource.data.status == 'active' &&
                       uidIsOwners(request.resource.data) && (
                         (request.resource.data.email == tourUserEmail() &&
                          request.resource.data.role == 'owner' &&
                          isOwnerOfTour(request.resource.data.tourId)) ||
                         (request.resource.data.email == tourUserEmail() &&
                          request.resource.data.role == 'member' &&
                          get(/databases/$(database)/documents/tours/$(request.resource.data.tourId)).data.inviteCode == request.resource.data.joinCode &&
                          !isBanned(request.resource.data.tourId)) ||
                         ((isOwnerOfTour(request.resource.data.tourId) || isTourAdmin(request.resource.data.tourId)) &&
                          request.resource.data.role == 'member' &&
                          !isTargetBanned(request.resource.data.tourId, request.resource.data.email))
                       );
      allow update: if isAuth() &&
                       request.resource.data.tourId == resource.data.tourId &&
                       request.resource.data.email == resource.data.email &&
                       (request.resource.data.get('uid', null) == resource.data.get('uid', null) ||
                        (resource.data.email == tourUserEmail() && request.resource.data.get('uid', null) == request.auth.uid)) && (
                         isOwnerOfTour(resource.data.tourId) ||
                         (isTourAdmin(resource.data.tourId) &&
                          request.resource.data.role == 'member' &&
                          !isTargetBanned(resource.data.tourId, resource.data.email)) ||
                         (resource.data.email == tourUserEmail() &&
                          request.resource.data.role == resource.data.role &&
                          request.resource.data.status == resource.data.status &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['displayName', 'photoUrl', 'tourName', 'familyCount', 'uid']))
                       );
      // The owner row can't be removed; ownership moves first. Members can leave.
      allow delete: if isAuth() && (
                       (resource.data.role != 'owner' && (
                         resource.data.email == tourUserEmail() ||
                         isOwnerOfTour(resource.data.tourId) ||
                         (isTourAdmin(resource.data.tourId) && resource.data.role == 'member')
                       )) ||
                       // The owner's own row can only be cleared once the tour is gone.
                       (resource.data.role == 'owner' && resource.data.email == tourUserEmail() &&
                        !exists(/databases/$(database)/documents/tours/$(resource.data.tourId)))
                     );
    }

    // Anything not matched above is denied. Rules grant only what a match allows, so this
    // changes nothing today; it keeps a new collection closed until it is written for.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
